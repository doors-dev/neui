package page

import "github.com/doors-dev/gox"

elem element(id string) {
	<script data:id=(id)>
		const id = $data("id")
		const outcome = (...reports) => {
			const ok = reports.reduce((n, r) => n + r.ok, 0)
			const failed = reports.reduce((n, r) => n + r.failed.length, 0)
			const canceled = reports.reduce((n, r) => n + r.canceled, 0)
			if (ok === 0 && failed > 0 && canceled > 0) {
				throw new Error("its server handlers failed or were canceled")
			}
			if (ok === 0 && failed > 0) {
				throw new Error("its server handlers failed")
			}
			if (ok === 0 && canceled > 0) {
				throw new Error(
					"the page canceled its server handlers, as it does while an earlier action is still being handled",
				)
			}
			if (failed > 0 && canceled > 0) {
				return { handled: true, note: "some of its server handlers failed and some were canceled" }
			}
			if (failed > 0) {
				return { handled: true, note: "some of its server handlers failed" }
			}
			if (canceled > 0) {
				return { handled: true, note: "some of its server handlers were canceled" }
			}
			return { handled: ok > 0 }
		}
		const act = async (el, kind) => {
			const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches
			let rect = el.getBoundingClientRect()
			if (rect.width === 0 && rect.height === 0) {
				return
			}
			if (rect.top < 0 || rect.left < 0 || rect.bottom > innerHeight || rect.right > innerWidth) {
				el.scrollIntoView({ behavior: reduce ? "instant" : "smooth", block: "nearest", inline: "nearest" })
				for (let i = 0; i < 20 && !reduce && !document.hidden; i++) {
					await new Promise((resolve) => setTimeout(resolve, 50))
					const next = el.getBoundingClientRect()
					if (i > 0 && next.top === rect.top && next.left === rect.left) {
						break
					}
					rect = next
				}
				rect = el.getBoundingClientRect()
			}
			if (!el.isConnected) {
				return
			}
			if (!document.querySelector("style[data-neui-act]")) {
				const style = document.createElement("style")
				style.setAttribute("data-neui-act", "")
				style.textContent =
					'.neui-act{color:rgb(115 115 115);border-radius:4px;container-type:size}' +
					'.neui-act-click::after{content:"";position:absolute;left:50%;top:50%;width:calc(100cqmin + 32px);height:calc(100cqmin + 32px);border-radius:50%;background:currentColor;opacity:0;transform:translate(-50%,-50%);animation:neui-act-ripple 400ms ease-out}' +
					'@keyframes neui-act-ripple{from{opacity:.4;transform:translate(-50%,-50%) scale(.1)}to{opacity:0;transform:translate(-50%,-50%) scale(1)}}' +
					'.neui-act-write{outline:2px solid currentColor;outline-offset:2px;box-shadow:0 0 12px 2px currentColor;opacity:0;animation:neui-act-glow 600ms ease-out}' +
					'@keyframes neui-act-glow{20%{opacity:1}to{opacity:0}}' +
					'@media (prefers-reduced-motion:reduce){.neui-act{opacity:1;animation:none;outline:2px solid currentColor;outline-offset:2px;box-shadow:none}.neui-act::after{content:none}}'
				;(document.head || document.documentElement).prepend(style)
			}
			const overlay = document.createElement("div")
			overlay.className = "neui-act neui-act-" + kind
			overlay.setAttribute("aria-hidden", "true")
			overlay.style.cssText =
				"position:fixed;margin:0;box-sizing:border-box;pointer-events:none;z-index:2147483647" +
				";top:" + rect.top + "px;left:" + rect.left + "px;width:" + rect.width + "px;height:" + rect.height + "px"
			document.body.append(overlay)
			const animations = overlay.getAnimations({ subtree: true })
			if (animations.length === 0) {
				setTimeout(() => overlay.remove(), 600)
				return
			}
			Promise.allSettled(animations.map((a) => a.finished)).then(() => overlay.remove())
		}
		$on(id, async ({ action, value }) => {
			const el = document.querySelector('[data-neid="' + id + '"]')
			if (!el) {
				throw new Error("element is not rendered")
			}
			const tag = el.tagName.toLowerCase()
			const type = (el.getAttribute("type") || "").toLowerCase()
			const refused = el.matches(":disabled") || el.closest("[inert]") !== null
			if (type === "file" && (action === "click" || action === "input")) {
				throw new Error(
					"a file input can't be set or opened by you: focus it and ask the user to choose a file",
				)
			}
			switch (action) {
				case "click": {
					await act(el, "click")
					const report = await $sys.emit(
						el,
						new PointerEvent("click", { bubbles: true, cancelable: true }),
					)
					return outcome(report)
				}
				case "focus": {
					const trigger = new EventTarget()
					trigger.addEventListener("focus", () => el.focus({ preventScroll: true }))
					await $sys.emit(trigger, new Event("focus"))
					el.scrollIntoView({ behavior: "smooth", block: "nearest" })
					return {}
				}
				case "read": {
					const disabled = refused || el.getAttribute("aria-disabled") === "true"
					const label =
						el.labels && el.labels[0]
							? el.labels[0].textContent.trim()
							: el.getAttribute("aria-label") || ""
					const text = el.textContent.trim() || el.getAttribute("aria-label") || ""
					if (tag === "a") {
						return { label: text, href: el.getAttribute("href"), disabled }
					}
					if (tag === "button") {
						return {
							...(el.value ? { value: el.value } : {}),
							label: text,
							disabled,
						}
					}
					if (["submit", "button", "reset"].includes(type)) {
						return { value: el.value, label: el.value, disabled }
					}
					if (type === "image") {
						return { value: el.value, label: el.alt || "", disabled }
					}
					if (type === "checkbox") {
						return { value: el.checked, label, disabled }
					}
					if (type === "file") {
						return {
							files: Array.from(el.files).map((f) => f.name),
							label,
							disabled,
						}
					}
					if (tag === "select") {
						const options = Array.from(el.options).map((o) => ({
							value: o.value,
							label: o.label,
							selected: o.selected,
							disabled: o.disabled,
						}))
						const value = el.multiple
							? Array.from(el.selectedOptions).map((o) => o.value)
							: el.value
						return { value, options, label, disabled }
					}
					return { value: el.value, label, disabled }
				}
				case "input": {
					if (
						tag === "a" ||
						tag === "button" ||
						["submit", "button", "reset", "image"].includes(type)
					) {
						throw new Error("not an input")
					}
					if (type === "checkbox") {
						if (typeof value !== "boolean") {
							throw new Error("a checkbox takes true or false")
						}
						if (el.checked === value) {
							return { handled: false }
						}
						await act(el, "write")
						const report = await $sys.emit(
							el,
							new PointerEvent("click", { bubbles: true, cancelable: true }),
						)
						return outcome(report)
					}
					if (refused) {
						throw new Error("target is disabled")
					}
					if (tag === "select") {
						const values = el.multiple && Array.isArray(value) ? value : [value]
						const options = Array.from(el.options)
						for (const v of values) {
							if (!options.some((o) => o.value === String(v))) {
								throw new Error("no option with value " + JSON.stringify(v))
							}
						}
						if (el.multiple) {
							for (const o of options) {
								o.selected = values.map(String).includes(o.value)
							}
						} else {
							el.value = value
						}
						await act(el, "write")
						const report = await $sys.emit(el, new Event("change", { bubbles: true }))
						return outcome(report)
					}
					const asked = String(value)
					const old = el.value
					el.value = value
					const got = String(el.value)
					const trim = (s) => s.replace(/^[\t\n\f\r ]+|[\t\n\f\r ]+$/g, "")
					let accepted = got === asked || got === asked.replace(/^[\r\n]+|[\r\n]+$/g, "")
					if (tag === "textarea") {
						accepted = got === asked.replace(/\r\n?/g, "\n")
					} else if (type === "range") {
						accepted = trim(asked) !== "" && Number(got) === Number(asked)
					} else if (type === "color") {
						const paint = document.createElement("canvas").getContext("2d")
						paint.fillStyle = "transparent"
						paint.fillStyle = asked
						accepted = got === paint.fillStyle
					} else if (type === "email" || type === "url") {
						accepted = got === (el.multiple ? asked.split(",").map(trim).join(",") : trim(asked))
					} else if (type === "datetime-local") {
						accepted = got !== "" || asked === ""
					}
					if (!accepted) {
						el.value = old
						throw new Error("the field did not accept this value")
					}
					await act(el, "write")
					const input = await $sys.emit(el, new Event("input", { bubbles: true }))
					const change = await $sys.emit(el, new Event("change", { bubbles: true }))
					return outcome(input, change)
				}
			}
			throw new Error("unknown action " + action)
		})
	</script>
}

elem radioGroup(id string) {
	<script data:id=(id)>
		const id = $data("id")
		const outcome = (...reports) => {
			const ok = reports.reduce((n, r) => n + r.ok, 0)
			const failed = reports.reduce((n, r) => n + r.failed.length, 0)
			const canceled = reports.reduce((n, r) => n + r.canceled, 0)
			if (ok === 0 && failed > 0 && canceled > 0) {
				throw new Error("its server handlers failed or were canceled")
			}
			if (ok === 0 && failed > 0) {
				throw new Error("its server handlers failed")
			}
			if (ok === 0 && canceled > 0) {
				throw new Error(
					"the page canceled its server handlers, as it does while an earlier action is still being handled",
				)
			}
			if (failed > 0 && canceled > 0) {
				return { handled: true, note: "some of its server handlers failed and some were canceled" }
			}
			if (failed > 0) {
				return { handled: true, note: "some of its server handlers failed" }
			}
			if (canceled > 0) {
				return { handled: true, note: "some of its server handlers were canceled" }
			}
			return { handled: ok > 0 }
		}
		const act = async (el, kind) => {
			const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches
			let rect = el.getBoundingClientRect()
			if (rect.width === 0 && rect.height === 0) {
				return
			}
			if (rect.top < 0 || rect.left < 0 || rect.bottom > innerHeight || rect.right > innerWidth) {
				el.scrollIntoView({ behavior: reduce ? "instant" : "smooth", block: "nearest", inline: "nearest" })
				for (let i = 0; i < 20 && !reduce && !document.hidden; i++) {
					await new Promise((resolve) => setTimeout(resolve, 50))
					const next = el.getBoundingClientRect()
					if (i > 0 && next.top === rect.top && next.left === rect.left) {
						break
					}
					rect = next
				}
				rect = el.getBoundingClientRect()
			}
			if (!el.isConnected) {
				return
			}
			if (!document.querySelector("style[data-neui-act]")) {
				const style = document.createElement("style")
				style.setAttribute("data-neui-act", "")
				style.textContent =
					'.neui-act{color:rgb(115 115 115);border-radius:4px;container-type:size}' +
					'.neui-act-click::after{content:"";position:absolute;left:50%;top:50%;width:calc(100cqmin + 32px);height:calc(100cqmin + 32px);border-radius:50%;background:currentColor;opacity:0;transform:translate(-50%,-50%);animation:neui-act-ripple 400ms ease-out}' +
					'@keyframes neui-act-ripple{from{opacity:.4;transform:translate(-50%,-50%) scale(.1)}to{opacity:0;transform:translate(-50%,-50%) scale(1)}}' +
					'.neui-act-write{outline:2px solid currentColor;outline-offset:2px;box-shadow:0 0 12px 2px currentColor;opacity:0;animation:neui-act-glow 600ms ease-out}' +
					'@keyframes neui-act-glow{20%{opacity:1}to{opacity:0}}' +
					'@media (prefers-reduced-motion:reduce){.neui-act{opacity:1;animation:none;outline:2px solid currentColor;outline-offset:2px;box-shadow:none}.neui-act::after{content:none}}'
				;(document.head || document.documentElement).prepend(style)
			}
			const overlay = document.createElement("div")
			overlay.className = "neui-act neui-act-" + kind
			overlay.setAttribute("aria-hidden", "true")
			overlay.style.cssText =
				"position:fixed;margin:0;box-sizing:border-box;pointer-events:none;z-index:2147483647" +
				";top:" + rect.top + "px;left:" + rect.left + "px;width:" + rect.width + "px;height:" + rect.height + "px"
			document.body.append(overlay)
			const animations = overlay.getAnimations({ subtree: true })
			if (animations.length === 0) {
				setTimeout(() => overlay.remove(), 600)
				return
			}
			Promise.allSettled(animations.map((a) => a.finished)).then(() => overlay.remove())
		}
		$on(id, async ({ action, value }) => {
			const els = Array.from(document.querySelectorAll('[data-neid="' + id + '"]'))
			if (els.length === 0) {
				throw new Error("element is not rendered")
			}
			switch (action) {
				case "focus": {
					const el = els.find((el) => el.checked) || els[0]
					const trigger = new EventTarget()
					trigger.addEventListener("focus", () => el.focus({ preventScroll: true }))
					await $sys.emit(trigger, new Event("focus"))
					el.scrollIntoView({ behavior: "smooth", block: "nearest" })
					return {}
				}
				case "read": {
					const options = els.map((el) => ({
						value: el.value,
						label:
							el.labels && el.labels[0]
								? el.labels[0].textContent.trim()
								: el.getAttribute("aria-label") || "",
						selected: el.checked,
						disabled:
							el.matches(":disabled") ||
							el.closest("[inert]") !== null ||
							el.getAttribute("aria-disabled") === "true",
					}))
					const checked = els.find((el) => el.checked)
					return { value: checked ? checked.value : null, options }
				}
				case "input": {
					const el = els.find((el) => el.value === String(value))
					if (!el) {
						throw new Error("no option with value " + JSON.stringify(value))
					}
					if (el.checked) {
						return { handled: false }
					}
					await act(el, "write")
					const report = await $sys.emit(
						el,
						new PointerEvent("click", { bubbles: true, cancelable: true }),
					)
					return outcome(report)
				}
			}
			throw new Error("unknown action " + action)
		})
	</script>
}
