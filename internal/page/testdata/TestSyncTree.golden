            "name": "add",
            "desc": "adds an item\nOutput schema: {\"definitions\":{\"PageChangesResult\":{\"properties\":{\"pageSeq\":{\"description\":\"pass as sincePageSeq next time\",\"minimum\":0,\"type\":\"integer\"},\"spaces\":{\"description\":\"spaces changed since sincePageSeq, each with its own seq, tools, inputs and children previews; a space whose children changed is listed even if its own seq did not change: its children list is the current truth, a child missing from it was removed; empty means nothing changed\",\"items\":{\"$ref\":\"#/definitions/PageSyncSpace\"},\"type\":[\"array\",\"null\"]}},\"type\":\"object\"},\"PageInput\":{\"properties\":{\"desc\":{\"type\":\"string\"},\"disabled\":{\"description\":\"present and true when the element is disabled\",\"type\":\"boolean\"},\"id\":{\"description\":\"pass to read, write, click and focus\",\"minimum\":0,\"type\":\"integer\"},\"kind\":{\"description\":\"button, link, input or radio; button and link take click, input and radio take write; a radio entry stands for its whole same-name group\",\"type\":\"string\"},\"name\":{\"description\":\"html name attribute\",\"type\":\"string\"},\"rights\":{\"description\":\"RW allows every call, R only read and focus, W only click, write and focus\",\"type\":\"string\"},\"type\":{\"description\":\"html flavor of the element\",\"type\":\"string\"}},\"type\":\"object\"},\"PageSyncData\":{\"properties\":{\"object\":{\"description\":\"structured payload, shape is the developer's choice\"},\"text\":{\"description\":\"the developer's note in plain words, on its own or telling what the object is\",\"type\":\"string\"}},\"type\":\"object\"},\"PageSyncSpace\":{\"properties\":{\"children\":{\"additionalProperties\":{\"$ref\":\"#/definitions/PageSyncSpace\"},\"description\":\"children spaces; a space showing only path and desc is a preview beyond depth, sync its path to open it\",\"type\":\"object\"},\"data\":{\"description\":\"information the developer attached for you: anything that helps serve the user here — objects, hints, notes; it is context for you, not a copy of the screen, and may describe things the page does not display\",\"items\":{\"$ref\":\"#/definitions/PageSyncData\"},\"type\":\"array\"},\"desc\":{\"type\":\"string\"},\"inputs\":{\"description\":\"interactive inputs, address them with the input tool\",\"items\":{\"$ref\":\"#/definitions/PageInput\"},\"type\":\"array\"},\"island\":{\"description\":\"this space is an island: run an app in it with the island tools\",\"type\":\"boolean\"},\"path\":{\"description\":\"pass to every other page call\",\"type\":\"string\"},\"seq\":{\"description\":\"the space's seq, pass it to every call on this space; it changes only with the space's own tools, inputs and data, or a re-render, not when children come or go; previews omit it, so sync the path to get it\",\"minimum\":0,\"type\":\"integer\"},\"tools\":{\"description\":\"tools callable in this space\",\"items\":{\"$ref\":\"#/definitions/PageSyncTool\"},\"type\":\"array\"}},\"type\":\"object\"},\"PageSyncTool\":{\"properties\":{\"desc\":{\"type\":\"string\"},\"inputSchema\":{\"description\":\"JSON schema of the tool call arg\"},\"name\":{\"type\":\"string\"}},\"type\":\"object\"}},\"properties\":{\"changes\":{\"$ref\":\"#/definitions/PageChangesResult\",\"description\":\"other spaces changed since just before this call, possibly by other causes too, with their current seqs, so no sync is needed; the called space is listed too if its own tools, inputs or data changed\"},\"output\":{\"description\":\"what the page tool returned\",\"type\":\"string\"},\"seq\":{\"description\":\"the called space's seq after this call; pass it to the next call on this space; 0 means the call removed or re-rendered the space, so sync its path\",\"minimum\":0,\"type\":\"integer\"}},\"type\":\"object\"}",
