package layouts

import (
	"strconv"
	
	"github.com/doors-dev/gox"
)

func Column(p ColumnParams, children []gox.Comp) gox.Comp {
	gap := p.Gap
	if gap == "" {
		gap = "md"
	}
	class := "kisland-column kisland-gap-" + gap
	if p.Fill > 0 {
		class += " kisland-fill-" + strconv.Itoa(p.Fill)
	}
	return <div class=(class)>~(children)</div>
}

func Row(p RowParams, children []gox.Comp) gox.Comp {
	gap := p.Gap
	if gap == "" {
		gap = "md"
	}
	align := p.Align
	if align == "" {
		align = "start"
	}
	justify := p.Justify
	if justify == "" {
		justify = "start"
	}
	return <div class=("kisland-row kisland-gap-" + gap + " kisland-align-" + align + " kisland-justify-" + justify)>~(children)</div>
}

func Grid(p GridParams, children []gox.Comp) gox.Comp {
	gap := p.Gap
	if gap == "" {
		gap = "md"
	}
	item := p.Item
	if item == "" {
		item = "md"
	}
	return <div class=("kisland-grid kisland-gap-" + gap + " kisland-item-" + item)>
		~(for _, c := range children {
			<div class="kisland-grid-cell">~(c)</div>
		})
	</div>
}
