package table

import (
	"cmp"
	"context"
	"maps"
	"slices"
	"strconv"
	"strings"
	"time"
	"unicode/utf8"
	
	"github.com/doors-dev/doors"
	"github.com/doors-dev/gox"
	"neui.dev"
	"neui.dev/api"
	"neui.dev/internal/markdown"
	"neui.dev/neisland/internal/files"
)
type checkboxState int

const (
	checkboxUnchecked checkboxState = iota
	checkboxChecked
	checkboxDisabled
)

type widget struct {
	params Params
	state doors.Source[state]
	body doors.Beam[int]
	selected doors.Source[map[string]struct{}]
	submit func(ctx context.Context, s Submit) bool
}

// New builds a table widget for Library.Control. Its rows are either fixed
// (the rows param) or fetched a page at a time by the query param, with
// numbered pages when the query reports a total and previous and next
// otherwise. Columns marked sort get header controls that sort ascending and
// then flip; the search param adds a search input. Fixed rows are searched
// and sorted by the table, a query gets the sort and search text on every
// call; either change goes back to the first page. A click on a row's first
// cell (when clickable) submits the row id, and a click on one of its action
// buttons submits the row id and the button's value, to the script waiting
// in ui.draw(). When selectable, rows
// get checkboxes; the selection, at most 1000 ids, survives page changes and
// reloads, and its button submits the selected ids, sorted. An
// empty patch reloads the rows.
func New(ctx context.Context, p Params, submit func(ctx context.Context, s Submit) bool) (api.Widget[Patch], error) {
	p.initDefault()
	source := doors.NewSourceEqual(p.state(), stateEqual)
	return widget{
		params: p,
		state: source,
		body: doors.DeriveBeam(source, func(s state) int {
			return s.seq
		}),
		selected: doors.DeriveSourceEqual(source, func(s state) map[string]struct{} {
			return s.selected
		}, func(s state, selected map[string]struct{}) state {
			s.selected = selected
			return s
		}, maps.Equal),
		submit: submit,
	}, nil
}

func (t widget) Update(ctx context.Context, patch Patch) {
	t.state.Mutate(ctx, func(s state) state {
		s.seq++
		if patch.Query != "" {
			s.query, s.rows = patch.Query, nil
			s.page = 1
			s.selected = nil
		}
		if patch.Rows != nil {
			s.query, s.rows = "", rowsPlain(patch.Rows)
			s.page = 1
			kept := make(map[string]struct{})
			for _, r := range patch.Rows {
				if _, ok := s.selected[r.ID]; ok {
					kept[r.ID] = struct{}{}
				}
			}
			s.selected = kept
		}
		if patch.PageSize != 0 {
			s.size = patch.PageSize
			s.page = 1
		}
		if patch.Selected != nil {
			s.selected = make(map[string]struct{}, len(patch.Selected))
			for _, id := range patch.Selected {
				s.selected[id] = struct{}{}
			}
		}
		if patch.Sort != nil && patch.Sort.Column >= 0 && patch.Sort.Column < len(t.params.Columns) && t.params.Columns[patch.Sort.Column].Sort {
			s.sort = &sortSpec{Column: patch.Sort.Column, Desc: patch.Sort.Desc}
			s.page = 1
		}
		return s
	})
}

elem (t widget) Main() {
	<div class="neisland-table-card">
		~(if t.params.Search {
			<div class="neisland-table-card-head">
				<input
					type="search"
					class="neisland-form-search-input neisland-table-search"
					placeholder="Search"
					aria-label="Search"
					maxlength="100"
					(doors.AInput{
						Scope: &doors.ScopeDebounce{Duration: 250 * time.Millisecond, Limit: time.Second},
						Race: doors.RaceStrict,
						On: func(ctx context.Context, r doors.RequestInput) bool {
							text := strings.TrimSpace(r.Event().Value)
							if utf8.RuneCountInString(text) > 100 {
								text = string([]rune(text)[:100])
							}
							t.state.Mutate(ctx, func(s state) state {
								if s.search != text {
									s.search, s.page = text, 1
									s.seq += 1
								}
								return s
							})
							return false
						},
					})/>
			</div>
		})
		~(t.body.Bind(func(i int) gox.Elem {
			return t.render()
		}))
	</div>
}

elem (t widget) render() {
	~~
	current, ok := t.state.Read(ctx)
	if !ok {
		return
	}
	content, err := current.data(ctx)
	if err == nil && len(content.Rows) == 0 && current.isQuerySource() && current.page != 1 {
		t.state.Mutate(ctx, func(ts state) state {
			if ts.page == 1 {
				return ts
			}
			last := ts.page - 1
			if content.Total != nil {
				last = max(1, (*content.Total + ts.size - 1) / ts.size)
			}
			if last >= ts.page {
				last = 1
			}
			ts.page = last
			ts.seq += 1
			return ts
		})
		return
	}
	size := current.size
	page := current.page
	failed := ""
	if err != nil {
		failed = "Could not load the rows."
	}
	actions := slices.ContainsFunc(content.Rows, func(r row) bool {
		return len(r.Actions) > 0
	})
	columnCount := len(t.params.Columns)
	if actions {
		columnCount++
	}
	if t.params.Selectable {
		columnCount++
	}
	~~
	<>
		<div class="neisland-table-card-box" tabindex="0" role="region" aria-label="Table">
			<table class="neisland-table-grid">
				<thead>
					<tr>
						~({
							if !t.params.Selectable {
								return nil
							}
							ids := make([]string, len(content.Rows))
							for i, r := range content.Rows {
								ids[i] = r.ID
							}
							return <th scope="col" class="neisland-table-head-cell neisland-table-check">
								<label class="neisland-table-check-target">~(t.checkboxHeader(ids))</label>
							</th>
						})
						~(for i, c := range t.params.Columns {
							~(t.header(i, c, current.sort))
						})
						~(if actions {
							<th scope="col" class="neisland-table-head-cell" aria-label="Actions"></th>
						})
					</tr>
				</thead>
				<tbody>
					~(if failed != "" {
						<tr class="neisland-table-message-row"><td class="neisland-table-cell neisland-table-error" colspan=(columnCount)>~(failed)</td></tr>
					} else if len(content.Rows) == 0 {
						<tr class="neisland-table-message-row">
							<td class="neisland-table-cell neisland-table-empty" colspan=(columnCount)>
								~({
									if current.search != "" {
										return "No matching rows"
									}
									return "No rows"
								})
							</td>
						</tr>
					} else {
						~(for _, r := range content.Rows {
							<tr class="neisland-table-row">
								~(if t.params.Selectable {
									<td class="neisland-table-cell neisland-table-check">
										~({
											label := r.ID
											if len(r.Cells) > 0 && r.Cells[0] != "" {
												label = cmp.Or(markdown.Plain(markdown.Inline(string(r.Cells[0]))), r.ID)
											}
											return <label class="neisland-table-check-target">~(t.checkbox("Select " + label, r.ID))</label>
										})
									</td>
								})
								~(for i := range t.params.Columns {
									~~
									c := ""
									if i < len(r.Cells) {
										c = string(r.Cells[i])
									}
									~~
									<td class="neisland-table-cell">
										~(if i == 0 && t.params.Clickable {
											<button
												type="button"
												class="neisland-table-link"
												(doors.AClick{
													Scope: neui.IslandScope(ctx),
													On: func(ctx context.Context, _ doors.RequestPointer) bool {
														t.submit(ctx, Submit{ID: r.ID})
														return false
													},
												})>
												~(markdown.Plain(markdown.Inline(c)))
											</button>
										} else if c != "" {
											<span class="neisland-prose neisland-table-prose">~(files.MarkdownBody(neui.IslandFS(ctx), markdown.Inline(c)))</span>
										})
									</td>
								})
								~(if actions {
									<td class="neisland-table-cell neisland-table-actions">
										~(for _, a := range r.Actions {
											<button
												type="button"
												class=("neisland-button neisland-table-action neisland-button-" + cmp.Or(a.Style, "secondary"))
												(doors.AClick{
													Scope: neui.IslandScope(ctx),
													On: func(ctx context.Context, _ doors.RequestPointer) bool {
														t.submit(ctx, Submit{ID: r.ID, Value: a.Value})
														return false
													},
												})>
												~(a.Text)
											</button>
										})
									</td>
								})
							</tr>
						})
						~(if page > 1 || content.Total != nil && *content.Total > size {
							~(for range size - len(content.Rows) {
								<tr class="neisland-table-filler" aria-hidden="true">
									~(if t.params.Selectable {
										<td class="neisland-table-cell neisland-table-check"></td>
									})
									~(for range t.params.Columns {
										<td class="neisland-table-cell"></td>
									})
									~(if actions {
										<td class="neisland-table-cell neisland-table-actions"></td>
									})
								</tr>
							})
						})
					})
				</tbody>
			</table>
		</div>
		<div class="neisland-table-footer neisland-table-footer-band">
			<div class="neisland-table-status">
				~(t.selected.Bind(func(sel map[string]struct{}) gox.Elem {
					return t.status(sel, content, page, size)
				}))
			</div>
			~(t.pager(content, page, size))
		</div>
	</>
}

elem (t widget) header(i int, c column, sort *sortSpec) {
	~(if !c.Sort {
		<th scope="col" class="neisland-table-head-cell">~(c.Title)</th>
	} else {
		<th
			scope="col"
			class="neisland-table-head-cell"
			aria-sort=({
				if sort == nil || sort.Column != i {
					return nil
				}
				if sort.Desc {
					return "descending"
				}
				return "ascending"
			})>
			<button
				type="button"
				class="neisland-table-sort"
				(doors.AClick{
					On: func(ctx context.Context, _ doors.RequestPointer) bool {
						t.state.Mutate(ctx, func(s state) state {
							s.sort = &sortSpec{Column: i, Desc: s.sort != nil && s.sort.Column == i && !s.sort.Desc}
							s.page = 1
							s.seq += 1
							return s
						})
						return false
					},
				})>
				~(c.Title)
				<span class="neisland-table-sort-icon" aria-hidden="true">
					~({
						if sort == nil || sort.Column != i {
							return "↕"
						}
						if sort.Desc {
							return "▼"
						}
						return "▲"
					})
				</span>
			</button>
		</th>
	})
}

elem (t widget) checkboxHeader(ids []string) {
	~~
	check := doors.DeriveBeam(t.selected, func(sel map[string]struct{}) checkboxState {
		n := 0
		for _, id := range ids {
			if _, ok := sel[id]; ok {
				n++
			}
		}
		switch {
		case len(ids) > 0 && n == len(ids):
			return checkboxChecked
		case len(ids) == 0 || len(sel) >= 1000:
			return checkboxDisabled
		default:
			return checkboxUnchecked
		}
	})
	~~
	~(check.Bind(elem(c checkboxState) {
		<input
			type="checkbox"
			class="neisland-table-checkbox"
			aria-label="Select all rows on this page"
			checked=(c == checkboxChecked)
			disabled=(c == checkboxDisabled)
			(doors.AClick{
				PreventDefault: true,
				Scope: new(doors.ScopeBlocking),
				On: func(ctx context.Context, _ doors.RequestPointer) bool {
					t.selected.Mutate(ctx, func(sel map[string]struct{}) map[string]struct{} {
						sel = maps.Clone(sel)
						if sel == nil {
							sel = make(map[string]struct{})
						}
						for _, id := range ids {
							if c == checkboxChecked {
								delete(sel, id)
							} else if len(sel) < 1000 {
								sel[id] = struct{}{}
							}
						}
						return sel
					})
					return false
				},
			})>
	}))
}

elem (t widget) checkbox(label string, id string) {
	~~
	check := doors.DeriveBeam(t.selected, func(sel map[string]struct{}) checkboxState {
		if _, ok := sel[id]; ok {
			return checkboxChecked
		}
		if len(sel) >= 1000 {
			return checkboxDisabled
		}
		return checkboxUnchecked
	})
	~~
	~(check.Bind(elem(c checkboxState) {
		<input
			type="checkbox"
			class="neisland-table-checkbox"
			aria-label=(label)
			checked=(c == checkboxChecked)
			disabled=(c == checkboxDisabled)
			(doors.AClick{
				PreventDefault: true,
				Scope: new(doors.ScopeBlocking),
				On: func(ctx context.Context, _ doors.RequestPointer) bool {
					t.selected.Mutate(ctx, func(sel map[string]struct{}) map[string]struct{} {
						sel = maps.Clone(sel)
						if sel == nil {
							sel = make(map[string]struct{})
						}
						if c == checkboxChecked {
							delete(sel, id)
						} else if len(sel) < 1000 {
							sel[id] = struct{}{}
						}
						return sel
					})
					return false
				},
			})>
	}))
}

elem (t widget) status(sel map[string]struct{}, content result, page int, size int) {
	~(if len(sel) > 0 {
		<span class="neisland-table-status-text" role="status"><span class="neisland-table-count">~(len(sel))</span> selected</span>
		<button
			type="button"
			class="neisland-button neisland-button-sm neisland-button-primary"
			(doors.AClick{
				Scope: neui.IslandScope(ctx),
				On: func(ctx context.Context, _ doors.RequestPointer) bool {
					t.submit(ctx, Submit{IDs: slices.Sorted(maps.Keys(sel))})
					return false
				},
			})>
			Submit
		</button>
		<button
			type="button"
			class="neisland-table-clear"
			(doors.AClick{
				On: func(ctx context.Context, _ doors.RequestPointer) bool {
					t.selected.Update(ctx, nil)
					return false
				},
			})>
			Clear
		</button>
	} else if len(content.Rows) == 0 {
		<span class="neisland-table-status-text" role="status">Nothing to show</span>
	} else {
		<span class="neisland-table-status-text" role="status">Showing <span class="neisland-table-count">~((page - 1) * size + 1)</span>–<span class="neisland-table-count">~((page - 1) * size + len(content.Rows))</span>~(if content.Total != nil {
			<> of <span class="neisland-table-count">~(*content.Total)</span></>
		})</span>
	})
}

elem (t widget) pager(content result, page int, size int) {
	~~
	pages := 0
	if content.Total != nil {
		pages = (*content.Total + size - 1) / size
	}
	first := max(1, min(page - 2, pages - 4))
	last := min(pages, first + 4)
	~~
	~(if content.Total != nil && pages > 1 {
		<nav class="neisland-table-pager" aria-label="Pagination">
			~(t.pageButton("First", 1, page > 1))
			~(t.pageButton("Prev", page - 1, page > 1))
			~(for n := first; n <= last; n++ {
				~(if n == page {
					<span class="neisland-table-current" aria-current="page">~(n)</span>
				} else {
					~(t.pageButton(strconv.Itoa(n), n, true))
				})
			})
			~(t.pageButton("Next", page + 1, page < pages))
			~(t.pageButton("Last", pages, page < pages))
		</nav>
	} else if content.Total == nil && (page > 1 || len(content.Rows) == size) {
		<nav class="neisland-table-pager" aria-label="Pagination">
			~(t.pageButton("Prev", page - 1, page > 1))
			~(t.pageButton("Next", page + 1, len(content.Rows) == size))
		</nav>
	})
}

elem (t widget) pageButton(label string, page int, enabled bool) {
	~(if !enabled {
		<button type="button" class="neisland-button neisland-table-page neisland-button-secondary" disabled>
			~(label)
		</button>
	} else {
		<button
			type="button"
			class="neisland-button neisland-table-page neisland-button-secondary"
			(doors.AClick{
				On: func(ctx context.Context, _ doors.RequestPointer) bool {
					t.state.Mutate(ctx, func(s state) state {
						s.page = page
						s.seq += 1
						return s
					})
					return false
				},
			})>
			~(label)
		</button>
	})
}
