package ui

import (
	"context"
	"errors"
	"fmt"
	"path"
	"slices"
	"strings"

	"github.com/doors-dev/doors"
	"github.com/doors-dev/gox"
)

func newFormWidgetFile(ctx context.Context, group formGroup, params fileInput) (*formWidgetFile, error) {
	field, err := group.newField(params.Name)
	if err != nil {
		return nil, err
	}
	return &formWidgetFile{
		id: doors.IDRand(),
		field: field,
		params: params,
		chosen: doors.NewSource(&[]formFileChosen{}),
	}, nil
}

type formFileChosen struct {
	Name string `json:"name"`
	Size int64 `json:"size"`
	Type string `json:"type"`
}

type formWidgetFile struct {
	id string
	field formGroupField
	params fileInput
	chosen doors.Source[*[]formFileChosen]
	invalid doors.Setter
}

func (f *formWidgetFile) name() string {
	return f.params.Name
}

func (f *formWidgetFile) inputName() string {
	return f.id
}

func (f *formWidgetFile) dir() string {
	return path.Join("island", f.id)
}

func (f *formWidgetFile) init(ctx context.Context, value any) error {
	if value != nil {
		return fmt.Errorf("field %q: default value is %T, a file field can't be prefilled", f.params.Name, value)
	}
	f.setLocked(ctx, nil, f.validate(nil))
	f.field.parent.form().files[f.id] = f
	return nil
}

func (f *formWidgetFile) destroy(ctx context.Context) {
	delete(f.field.parent.form().files, f.id)
	f.field.destroy(ctx)
}

func (f *formWidgetFile) update(ctx context.Context, files []formFileChosen) {
	files = slices.DeleteFunc(files, func(file formFileChosen) bool {
		return file.Name == "" || file.Name == "." || file.Name == ".." || strings.ContainsAny(file.Name, "/\\")
	})
	err := f.validate(files)
	f.field.mutex().Lock()
	defer f.field.mutex().Unlock()
	f.setLocked(ctx, files, err)
	f.chosen.Update(ctx, &files)
	doors.Call(ctx, f.invalid.Set("aria-invalid", formAria(formShownErr(err))))
}

func (f *formWidgetFile) setLocked(ctx context.Context, files []formFileChosen, err error) {
	var value any
	switch {
	case len(files) == 0:
	case f.params.Multiple:
		paths := make([]string, len(files))
		for i, file := range files {
			paths[i] = path.Join(f.dir(), file.Name)
		}
		value = paths
	default:
		value = path.Join(f.dir(), files[0].Name)
	}
	f.field.set(ctx, value, err)
}

func formFileSize(size int64) string {
	switch {
	case size < 1000:
		return fmt.Sprintf("%d B", size)
	case size < 1000*1000:
		return fmt.Sprintf("%d KB", (size + 500) / 1000)
	default:
		return fmt.Sprintf("%.1f MB", float64(size) / 1e6)
	}
}

elem (f *formWidgetFile) Main() {
	<div class="kisland-form-field">
		<span class="kisland-form-label" id=(f.id + "-l")>
			~(f.params.Label)
			~(f.field.error.RouteBeam(
				doors.RouteBeamMatch(func(err error) bool {
					return f.params.Required && errors.Is(err, errRequired)
				}, doors.RouteComp[error](<span class="kisland-form-required" aria-hidden="true">*</span>)),
			))
		</span>
		<label class="kisland-form-file">
			<input
				(&f.invalid)
				class="kisland-form-file-input"
				id=(f.id)
				type="file"
				name=(f.id)
				accept=(f.params.Accept)
				multiple=(f.params.Multiple)
				aria-required=(formAria(f.params.Required))
				aria-invalid=(formAria(formShownErr(f.field.error.Get())))
				aria-labelledby=(f.id + "-l")
				aria-describedby=(f.id + "-s " + f.id + "-e")/>
			<span class="kisland-form-file-button" aria-hidden="true">
				~(f.chosen.Bind(elem(files *[]formFileChosen) {
					~(if f.params.Multiple && len(*files) != 0 {
						Add files
					} else if f.params.Multiple {
						Choose files
					} else if len(*files) != 0 {
						Replace
					} else {
						Choose file
					})
				}))
			</span>
			<span class="kisland-form-file-summary" id=(f.id + "-s")>
				~(f.chosen.Bind(elem(files *[]formFileChosen) {
					~~
					total := int64(0)
					for _, file := range *files {
						total += file.Size
					}
					~~
					~(if len(*files) == 0 && f.params.Multiple {
						No files chosen
					} else if len(*files) == 0 {
						No file chosen
					} else if !f.params.Multiple {
						<span class="kisland-form-file-name">~((*files)[0].Name)</span>
						~(" · ", formFileSize(total))
					} else if len(*files) == 1 {
						~("1 file · ", formFileSize(total))
					} else {
						~(len(*files), " files · ", formFileSize(total))
					})
				}))
			</span>
		</label>
		~(f.chosen.Bind(elem(files *[]formFileChosen) {
			~(if f.params.Multiple && len(*files) != 0 {
				<ul class="kisland-form-file-list" aria-label="Chosen files">
					~(for _, file := range *files {
						<li class="kisland-form-file-item">
							<span class="kisland-form-file-name">~(file.Name)</span>
							<span class="kisland-form-file-meta">~(formFileSize(file.Size))</span>
							<button
								type="button"
								class="kisland-form-remove"
								data-file-remove=(file.Name)
								aria-label=("Remove " + file.Name)>×</button>
						</li>
					})
				</ul>
			})
		}))
		~(f.field.error.RouteBeam(
			doors.RouteBeamMatch(formShownErr, doors.RouteBind(func(err error) gox.Elem {
				return <p class="kisland-form-error" id=(f.id + "-e")>~(err.Error())</p>
			})),
		))
		<script
			(doors.AHook[[]formFileChosen]{
				Name: "files",
				Scope: f.field.scope(),
				On: func(ctx context.Context, r doors.RequestHook[[]formFileChosen]) (any, bool) {
					f.update(ctx, r.Data())
					return nil, false
				},
			})>
			const root = document.currentScript.parentElement
			const input = root.querySelector(".kisland-form-file-input")
			let files = []
			const send = async (next) => {
				const prev = files
				files = next
				const transfer = new DataTransfer()
				for (const file of files) {
					transfer.items.add(file)
				}
				input.files = transfer.files
				try {
					await $hook("files", files.map((file) => ({ name: file.name, size: file.size, type: file.type })))
				} catch {
					files = prev
					const restore = new DataTransfer()
					for (const file of files) {
						restore.items.add(file)
					}
					input.files = restore.files
				}
			}
			input.addEventListener("change", () => {
				const picked = Array.from(input.files)
				if (!input.multiple) {
					send(picked)
					return
				}
				send(files.filter((file) => !picked.some((p) => p.name === file.name)).concat(picked))
			})
			root.addEventListener("click", (event) => {
				const button = event.target.closest("[data-file-remove]")
				if (!button) {
					return
				}
				send(files.filter((file) => file.name !== button.dataset.fileRemove))
			})
		</script>
	</div>
}

func (f *formWidgetFile) validate(files []formFileChosen) error {
	if len(files) == 0 {
		if f.params.Required {
			return errRequired
		}
		return nil
	}
	if !f.params.Multiple && len(files) > 1 {
		return errors.New("choose one file")
	}
	if f.params.Accept == "" {
		return nil
	}
	for _, file := range files {
		accepted := false
		for _, token := range strings.Split(f.params.Accept, ",") {
			token = strings.ToLower(strings.TrimSpace(token))
			switch {
			case token == "":
			case strings.HasPrefix(token, "."):
				accepted = strings.HasSuffix(strings.ToLower(file.Name), token)
			case strings.HasSuffix(token, "/*"):
				accepted = strings.HasPrefix(strings.ToLower(file.Type), strings.TrimSuffix(token, "*"))
			default:
				accepted = strings.ToLower(file.Type) == token
			}
			if accepted {
				break
			}
		}
		if !accepted {
			return fmt.Errorf("%s isn't an accepted file type, choose %s", file.Name, f.params.Accept)
		}
	}
	return nil
}
