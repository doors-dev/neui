package ui

import (
	"cmp"
	"context"
	"maps"
	"slices"
	"strconv"
	"strings"
	"time"
	"unicode/utf8"
	
	"github.com/doors-dev/doors"
	"github.com/doors-dev/gox"
	"neui.dev"
	"neui.dev/api"
)
type checkboxState int

const (
	checkboxUnchecked checkboxState = iota
	checkboxChecked
	checkboxDisabled
)

type tableWidget struct {
	params table
	state doors.Source[tableState]
	body doors.Beam[int]
	selected doors.Source[map[string]struct{}]
	submit func(ctx context.Context, s tableSubmit) bool
}

// NewTable builds a table widget for Library.Control. Its rows are either fixed
// (the rows param) or fetched a page at a time by the query param, with
// numbered pages when the query reports a total and previous and next
// otherwise. Columns marked sort get header controls that sort ascending and
// then flip; the search param adds a search input. Fixed rows are searched
// and sorted by the table, a query gets the sort and search text on every
// call; either change goes back to the first page. A click on a row's first
// cell (when clickable) submits the row id, and a click on one of its action
// buttons submits the row id and the button's value, to the script waiting
// in ui.draw(). When selectable, rows
// get checkboxes; the selection, at most 1000 ids, survives page changes and
// reloads, and its button submits the selected ids in selection order. An
// empty patch reloads the rows.
func NewTable(p table, submit func(ctx context.Context, s tableSubmit) bool) api.Widget[tablePatch] {
	p.initDefault()
	state := doors.NewSourceEqual(p.state(), tableStateEqual)
	return tableWidget{
		params: p,
		state: state,
		body: doors.DeriveBeam(state, func(s tableState) int {
			return s.seq
		}),
		selected: doors.DeriveSourceEqual(state, func(s tableState) map[string]struct{} {
			return s.selected
		}, func(s tableState, selected map[string]struct{}) tableState {
			s.selected = selected
			return s
		}, maps.Equal),
		submit: submit,
	}
}

func (t tableWidget) Update(ctx context.Context, patch tablePatch) {
	t.state.Mutate(ctx, func(s tableState) tableState {
		s.seq++
		if patch.Query != "" {
			s.query = patch.Query
			s.page = 1
			s.selected = nil
		}
		if patch.Rows != nil {
			s.rows = patch.Rows
			s.page = 1
			s.selected = nil
		}
		if patch.PageSize != 0 {
			s.size = patch.PageSize
			s.page = 1
		}
		if patch.Selected != nil {
			s.selected = make(map[string]struct{}, len(patch.Selected))
			for _, id := range patch.Selected {
				s.selected[id] = struct{}{}
			}
		}
		if patch.Sort != nil && patch.Sort.Column >= 0 && patch.Sort.Column < len(t.params.Columns) && t.params.Columns[patch.Sort.Column].Sort {
			s.sort = &tableSort{Column: patch.Sort.Column, Desc: patch.Sort.Desc}
			s.page = 1
		}
		return s
	})
}

elem (t tableWidget) Main() {
	<div class="kisland-table">
		~(if t.params.Search {
			<input
				type="search"
				class="kisland-table-search"
				placeholder="search"
				aria-label="smth"
				maxlength="100"
				(doors.AInput{
					Scope: &doors.ScopeDebounce{Duration: 300 * time.Millisecond},
					Race: doors.RaceStrict,
					On: func(ctx context.Context, r doors.RequestInput) bool {
						text := strings.TrimSpace(r.Event().Value)
						if utf8.RuneCountInString(text) > 100 {
							text = string([]rune(text)[:100])
						}
						t.state.Mutate(ctx, func(s tableState) tableState {
							if s.search != text {
								s.search, s.page = text, 1
								s.seq += 1
							}
							return s
						})
						return false
					},
				})/>
		})
		~(t.body.Bind(func(i int) gox.Elem {
			return t.render()
		}))
		~(t.selected.Bind(t.bar))
	</div>
}

elem (t tableWidget) render() {
	~~
	state, ok := t.state.Read(ctx)
	if !ok {
		return
	}
	content, err := state.data(ctx)
	if err == nil && len(content.Rows) == 0 && state.isQuerySource() && state.page != 1 {
		t.state.Mutate(ctx, func(ts tableState) tableState {
			if ts.page == 1 {
				return ts
			}
			if content.Total != nil {
				ts.page = max(1, (*content.Total + ts.size - 1) / ts.size)
			} else {
				ts.page--
			}
			ts.seq += 1
			return ts
		})
		return
	}
	size := state.size
	page := state.page
	failed := ""
	if err != nil {
		failed = "Could not load the rows."
	}
	actions := slices.ContainsFunc(content.Rows, func(r tableRow) bool {
		return len(r.Actions) > 0
	})
	columsNumber := len(t.params.Columns)
	if actions {
		columsNumber++
	}
	if t.params.Selectable {
		columsNumber++
	}
	~~
	<>
		<table class="kisland-table-grid">
			<thead>
				<tr>
					~({
						if !t.params.Selectable {
							return nil
						}
						ids := make([]string, len(content.Rows))
						for i, r := range content.Rows {
							ids[i] = r.ID
						}
						return <th class="kisland-table-check">
							~(t.checkboxHeader(ids))
						</th>
					})
					~(for i, c := range t.params.Columns {
						~(t.header(i, c, state.sort))
					})
					~(if actions {
						<th aria-label="Actions"></th>
					})
				</tr>
			</thead>
			<tbody>
				~(if failed != "" {
					<tr><td class="kisland-table-error" colspan=(columsNumber)>~(failed)</td></tr>
				} else if len(content.Rows) == 0 {
					<tr>
						<td class="kisland-table-empty" colspan=(columsNumber)>
							~({
								if state.search != "" {
									return "No matching rows"
								}
								return "No rows"
							})
						</td>
					</tr>
				} else {
					~(for _, r := range content.Rows {
						<tr>
							~(if t.params.Selectable {
								<td class="kisland-table-check">
									~({
										label := r.ID
										if len(r.Cells) > 0 && r.Cells[0] != "" {
											label = string(r.Cells[0])
										}
										return t.checkbox("Select " + label, r.ID)
									})
								</td>
							})
							~(for i := range t.params.Columns {
								~~
								c := ""
								if i < len(r.Cells) {
									c = string(r.Cells[i])
								}
								~~
								<td>
									~(if i == 0 && t.params.Clickable {
										<button
											type="button"
											class="kisland-table-link"
											(doors.AClick{
												Scope: neui.IslandScope(ctx),
												On: func(ctx context.Context, _ doors.RequestPointer) bool {
													t.submit(ctx, tableSubmit{ID: r.ID})
													return false
												},
											})>
											~(c)
										</button>
									} else {
										~(c)
									})
								</td>
							})
							~(if actions {
								<td class="kisland-table-actions">
									~(for _, a := range r.Actions {
										<button
											type="button"
											class=("kisland-button kisland-button-sm kisland-button-" + cmp.Or(a.Style, "secondary"))
											(doors.AClick{
												Scope: neui.IslandScope(ctx),
												On: func(ctx context.Context, _ doors.RequestPointer) bool {
													t.submit(ctx, tableSubmit{ID: r.ID, Value: a.Value})
													return false
												},
											})>
											~(a.Text)
										</button>
									})
								</td>
							})
						</tr>
					})
				})
			</tbody>
		</table>
		~(t.pager(content, page, size))
	</>
}

elem (t tableWidget) header(i int, c tableColumn, sort *tableSort) {
	~(if !c.Sort {
		<th>~(c.Title)</th>
	} else {
		<th
			aria-sort=({
				if sort == nil || sort.Column != i {
					return nil
				}
				if sort.Desc {
					return "descending"
				}
				return "ascending"
			})>
			<button
				type="button"
				class="kisland-table-sort"
				(doors.AClick{
					On: func(ctx context.Context, _ doors.RequestPointer) bool {
						t.state.Mutate(ctx, func(s tableState) tableState {
							s.sort = &tableSort{Column: i, Desc: s.sort != nil && s.sort.Column == i && !s.sort.Desc}
							s.page = 1
							s.seq += 1
							return s
						})
						return false
					},
				})>
				~(c.Title)
				<span class="kisland-table-sort-icon" aria-hidden="true">
					~({
						if sort == nil || sort.Column != i {
							return "↕"
						}
						if sort.Desc {
							return "▼"
						}
						return "▲"
					})
				</span>
			</button>
		</th>
	})
}

elem (t tableWidget) checkboxHeader(ids []string) {
	~~
	check := doors.DeriveBeam(t.selected, func(sel map[string]struct{}) checkboxState {
		n := 0
		for _, id := range ids {
			if _, ok := sel[id]; ok {
				n++
			}
		}
		switch {
		case len(ids) > 0 && n == len(ids):
			return checkboxChecked
		case len(ids) == 0 || len(sel) >= 1000:
			return checkboxDisabled
		default:
			return checkboxUnchecked
		}
	})
	~~
	~(check.Bind(elem(c checkboxState) {
		<input
			type="checkbox"
			class="kisland-table-checkbox"
			aria-label="Select all rows on this page"
			checked=(c == checkboxChecked)
			disabled=(c == checkboxDisabled)
			(doors.AClick{
				On: func(ctx context.Context, _ doors.RequestPointer) bool {
					t.selected.Mutate(ctx, func(sel map[string]struct{}) map[string]struct{} {
						sel = maps.Clone(sel)
						if sel == nil {
							sel = make(map[string]struct{})
						}
						for _, id := range ids {
							if c == checkboxChecked {
								delete(sel, id)
							} else if len(sel) < 1000 {
								sel[id] = struct{}{}
							}
						}
						return sel
					})
					return false
				},
			})>
	}))
}

elem (t tableWidget) checkbox(label string, id string) {
	~~
	check := doors.DeriveBeam(t.selected, func(sel map[string]struct{}) checkboxState {
		if _, ok := sel[id]; ok {
			return checkboxChecked
		}
		if len(sel) >= 1000 {
			return checkboxDisabled
		}
		return checkboxUnchecked
	})
	~~
	~(check.Bind(elem(c checkboxState) {
		<input
			type="checkbox"
			class="kisland-table-checkbox"
			aria-label=(label)
			checked=(c == checkboxChecked)
			disabled=(c == checkboxDisabled)
			(doors.AClick{
				On: func(ctx context.Context, _ doors.RequestPointer) bool {
					t.selected.Mutate(ctx, func(sel map[string]struct{}) map[string]struct{} {
						sel = maps.Clone(sel)
						if sel == nil {
							sel = make(map[string]struct{})
						}
						if c == checkboxChecked {
							delete(sel, id)
						} else if len(sel) < 1000 {
							sel[id] = struct{}{}
						}
						return sel
					})
					return false
				},
			})>
	}))
}

elem (t tableWidget) bar(sel map[string]struct{}) {
	~(if len(sel) > 0 {
		<div class="kisland-table-selection">
			<span>~(len(sel), " selected")</span>
			<button
				type="button"
				class="kisland-button kisland-button-sm kisland-button-secondary"
				(doors.AClick{
					On: func(ctx context.Context, _ doors.RequestPointer) bool {
						t.selected.Update(ctx, nil)
						return false
					},
				})>
				Clear
			</button>
			<button
				type="button"
				class="kisland-button kisland-button-sm kisland-button-primary"
				(doors.AClick{
					Scope: neui.IslandScope(ctx),
					On: func(ctx context.Context, _ doors.RequestPointer) bool {
						t.submit(ctx, tableSubmit{IDs: slices.Sorted(maps.Keys(sel))})
						return false
					},
				})>
				Submit
			</button>
		</div>
	})
}

elem (t tableWidget) pager(content tableResult, page int, size int) {
	~~
	pages := 0
	if content.Total != nil {
		pages = (*content.Total + size - 1) / size
	}
	first := max(1, min(page - 2, pages - 4))
	last := min(pages, first + 4)
	~~
	~(if content.Total != nil && pages > 1 {
		<nav class="kisland-table-pager" aria-label="Pagination">
			~(t.pageButton("First", 1, page > 1))
			~(t.pageButton("Prev", page - 1, page > 1))
			~(for n := first; n <= last; n++ {
				~(if n == page {
					<span class="kisland-table-current" aria-current="page">~(n)</span>
				} else {
					~(t.pageButton(strconv.Itoa(n), n, true))
				})
			})
			~(t.pageButton("Next", page + 1, page < pages))
			~(t.pageButton("Last", pages, page < pages))
		</nav>
	} else if content.Total == nil && (page > 1 || len(content.Rows) == size) {
		<nav class="kisland-table-pager" aria-label="Pagination">
			~(t.pageButton("Prev", page - 1, page > 1))
			~(t.pageButton("Next", page + 1, len(content.Rows) == size))
		</nav>
	})
}

elem (t tableWidget) pageButton(label string, page int, enabled bool) {
	~(if !enabled {
		<button type="button" class="kisland-button kisland-button-sm kisland-button-secondary" disabled>
			~(label)
		</button>
	} else {
		<button
			type="button"
			class="kisland-button kisland-button-sm kisland-button-secondary"
			(doors.AClick{
				On: func(ctx context.Context, _ doors.RequestPointer) bool {
					t.state.Mutate(ctx, func(s tableState) tableState {
						s.page = page
						s.seq += 1
						return s
					})
					return false
				},
			})>
			~(label)
		</button>
	})
}
