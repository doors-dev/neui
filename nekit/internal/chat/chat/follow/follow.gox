package follow

import (
	"github.com/doors-dev/gox"
)

elem Mark() {
	<div class="nechat-follow">
		<script>
			const mark = document.currentScript.parentElement
			const log = mark.closest(".nechat-log")
			if (!log) return
			const shown = mark.getClientRects().length !== 0
			let end = mark.getBoundingClientRect().top
			for (const span of log.querySelectorAll(".nechat-span")) {
				end = Math.max(end, span.getBoundingClientRect().bottom)
			}
			const below = end - log.getBoundingClientRect().bottom
			mark.remove()
			if (!shown || below > 48) return
			requestAnimationFrame(() => log.scrollTo({ top: log.scrollHeight, behavior: "smooth" }))
		</script>
	</div>
}
