package chat

import (
	"context"
	"errors"
	"sync"
	"time"
	
	"github.com/doors-dev/doors"
	"github.com/doors-dev/gox"
	"neui.dev/api"
	"neui.dev/nekit/internal/chat/anchor"
	"neui.dev/nekit/internal/chat/chat/composer"
	"neui.dev/nekit/internal/chat/chat/composer/controller"
	"neui.dev/nekit/internal/chat/icons"
	"neui.dev/nekit/internal/chat/chat/list"
	"neui.dev/nekit/internal/chat/pops"
	"neui.dev/nekit/internal/chat/params"
	"neui.dev/nekit/internal/chat/notify"
)

type Chat struct {
	Params params.Params
	Inst api.Instance
	Pops pops.Popup[string]
	Badge doors.Source[Badge]
}

type Badge struct {
	Collapsed bool
	Running bool
	Block string
	Asking bool
	Ended bool
	Failed bool
}

const pasteAsFile = 64 * 1024

func (c Chat) Main() gox.Elem {
	return c.Inst.Render(c)
}

func (c Chat) Chat(thread api.ChatThread, s api.ChatState) api.Chat {
	controller := controller.New(thread, s.Input, s.Round != nil, s.Usage, s.Tasks, s.Compaction, s.CanCompact, s.Ask)
	at := anchor.Read(s.Meta)
	dead := doors.NewSource(alive)
	seed := Badge{Running: s.Round != nil, Block: "text", Asking: s.Ask != nil}
	if s.Round != nil {
		for content := range s.Round.Response.Iter() {
			switch content.(type) {
			case api.ContentText:
				seed.Block = "text"
			case api.ContentReasoning:
				seed.Block = "thinking"
				if c.Params.Off(params.Thinking) {
					seed.Block = "text"
				}
			case api.ContentToolUse:
				seed.Block = "tools"
			}
		}
	}
	return &chat{
		params: c.Params,
		thread: thread,
		inst: c.Inst,
		composer: controller,
		pops: c.Pops,
		list: list.New(c.Params, c.Inst, thread, controller, s.ID, s.Round, at, func(ctx context.Context, err error) {
			dead.Update(ctx, closedKindOf(err))
		}),
		name: doors.NewSource(s.Name),
		dead: dead,
		badge: c.Badge,
		seed: seed,
	}
}

type closedKind int

const (
	alive closedKind = iota
	failed
	deleted
	tooLong
)

func closedKindOf(err error) closedKind {
	if errors.Is(err, api.ErrNotFound) {
		return deleted
	}
	if errors.Is(err, api.ErrCompactionFailed) {
		return tooLong
	}
	return failed
}

elem (c Chat) Placeholder(enabled doors.Beam[bool]) {
	~~
	c.Badge.Mutate(ctx, func(b Badge) Badge {
		return Badge{Collapsed: b.Collapsed, Block: "text"}
	})
	~~
	~(enabled.Bind(elem(loading bool) {
		<div
			class="nechat-pane nechat-widget_off"
			aria-disabled="true"
			aria-busy=({
				if loading {
					return "true"
				}
				return "false"
			})>
			<div class="nechat-top"></div>
			<div class="nechat-log nechat-log_scroll" role="log" aria-label="Chat messages"></div>
			<div class="nechat-composer">
				<div class="nechat-tray">
				</div>
				<textarea class="nechat-draft" rows="2" aria-label="Message" disabled></textarea>
				<div class="nechat-barrow">
					<div class="nechat-barrow-left">
						~(if !c.Params.Off(params.Attachments) {
							<button class="nechat-iconbtn" aria-label="Attach files" disabled>
								~>(doors.Class("nechat-ic")) ~(icons.Attach())
							</button>
						})
					</div>
					<div class="nechat-barrow-right">
						<button class="nechat-iconbtn" disabled>
							~>(doors.Class("nechat-ic")) ~(icons.Submit())
						</button>
					</div>
				</div>
			</div>
		</div>
	}))
}

type chat struct {
	params params.Params
	thread api.ChatThread
	inst api.Instance
	composer controller.Controller
	pops pops.Popup[string]
	list list.List
	name doors.Source[string]
	dead doors.Source[closedKind]
	badge doors.Source[Badge]
	seed Badge
}

func (c *chat) Update(ctx context.Context, e api.ChatEvent) {
	doors.OnBatch(ctx, func(context.Context) {}, func(ctx context.Context) {
		if api.Final(e) {
			c.composer.UpdateActive(ctx, false)
			end, ok := e.(api.ChatEventRoundEnd)
			_, critical := e.(api.ChatEventCriticalError)
			c.badge.Mutate(ctx, func(b Badge) Badge {
				b.Running = false
				if b.Collapsed {
					b.Ended = true
					b.Failed = critical || ok && end.State == api.RoundError
				}
				return b
			})
		}
		switch e := e.(type) {
		case api.ChatEventName:
			c.name.Update(ctx, e.Name)
		case api.ChatEventRoundEnd:
			c.composer.RoundDone(ctx, e.State, e.Usage, e.CanCompact)
			c.list.RoundDone(ctx, e.State)
		case api.ChatEventRoundStart:
			c.composer.RoundStart(ctx, e.Usage, e.CanCompact)
			c.badge.Mutate(ctx, func(b Badge) Badge {
				b.Running = true
				b.Block = "text"
				return b
			})
			if e.Round.Input.Len() != 0 {
				c.composer.FlushInput(ctx)
			}
			c.list.RoundStart(ctx, e.Round, e.Truncate)
		case api.ChatEventInputPending:
			c.composer.UpdatePending(ctx, e.Pending)
		case api.ChatEventTasks:
			c.composer.UpdateTasks(ctx, e.Tasks)
		case api.ChatEventCompacting:
			c.composer.UpdateCompaction(ctx, e.Running, e.Usage, e.CanCompact)
			if e.Running {
				c.badge.Mutate(ctx, func(b Badge) Badge {
					b.Block = "text"
					return b
				})
			}
		case api.ChatEventRoundUsage:
			c.composer.UpdateUsage(ctx, e.Usage)
		case api.ChatEventAsk:
			c.composer.Ask(ctx, e.Ask)
			c.badge.Mutate(ctx, func(b Badge) Badge {
				b.Asking = true
				return b
			})
		case api.ChatEventAskDone:
			c.composer.AskDone(ctx)
			c.badge.Mutate(ctx, func(b Badge) Badge {
				b.Asking = false
				return b
			})
		case api.ChatEventIndexed:
			c.list.IndexedEvent(e.Event)
			block := ""
			switch e.Event.(type) {
			case api.EventText:
				block = "text"
			case api.EventThinking, api.EventSummary:
				block = "thinking"
				if c.params.Off(params.Thinking) {
					block = "text"
				}
			case api.EventTool:
				block = "tools"
			}
			if block != "" {
				c.badge.Mutate(ctx, func(b Badge) Badge {
					b.Block = block
					return b
				})
			}
		case api.ChatEventToolResults:
			c.list.ToolsDone()
		case api.ChatEventCriticalError:
			c.dead.Update(ctx, closedKindOf(e.Err))
			c.pops.Hide(ctx, "files")
		}
	})
}

elem (c *chat) Main() {
	~~
	c.badge.Mutate(ctx, func(b Badge) Badge {
		return Badge{
			Collapsed: b.Collapsed,
			Running: c.seed.Running,
			Block: c.seed.Block,
			Asking: c.seed.Asking,
		}
	})
	~~
	<div
		class="nechat-pane"
		data-attach=({
			if c.params.Off(params.Attachments) {
				return "off"
			}
			return nil
		})>
		<div class="nechat-top nechat-top_menu">
			~(c.name.Bind(title))
		</div>
		~(notify.Toasts())
		~(c.dead.Bind(c.body))
		~>doors.AHook[bool]{
			Name: "escape",
			Scope: new(doors.ScopeBlocking),
			On: func(ctx context.Context, r doors.RequestHook[bool]) (any, bool) {
				c.composer.Escape(ctx, r.Data())
				return nil, false
			},
		} <script data:id=(c.params.ID) data:paste=(pasteAsFile)>
			const main = document.currentScript.parentElement
			const widget = main.closest(".nechat-widget")
			const id = $data("id")
			const pasteAsFile = $data("paste")
			const keydown = (e) => {
				if (e.key !== "Escape") return
				const escape = new CustomEvent("nechat_escape", { cancelable: true })
				if (!widget.dispatchEvent(escape)) return
				if (!main.contains(e.target)) return
				$hook("escape", main.querySelector("#composer" + id)?.contains(e.target) === true).catch((err) => {
					if (err instanceof HookErr)
						widget.dispatchEvent(new CustomEvent("nechat_error", { detail: err.kind }))
				})
			}
			widget.addEventListener("keydown", keydown)
			$sys.clean(() => widget.removeEventListener("keydown", keydown))
			const attach = (files) => {
				const composer = main.querySelector("#composer" + id)
				if (!composer || composer.getAttribute("aria-busy") === "true") return false
				const input = main.querySelector("#attach" + id + " input")
				if (!input || !files.length) return false
				input.files = files
				input.dispatchEvent(new Event("change"))
				return true
			}
			main.addEventListener("paste", (e) => {
				const files = e.clipboardData.files
				if (files.length) {
					if (attach(files)) e.preventDefault()
					return
				}
				const text = e.clipboardData.getData("text/plain")
				if (main.dataset.attach === "off") return
				if (!text || new TextEncoder().encode(text).length <= pasteAsFile) return
				const head = text.slice(0, 64).split("\n", 1)[0]
				const base = head
					.replace(/[\\/:*?"<>|\x00-\x1f]+/g, " ")
					.replace(/\s+/g, " ")
					.replace(/^[.\s]+/, "")
					.trim()
					.slice(0, 40)
				const dt = new DataTransfer()
				dt.items.add(
					new File([text], (base || "pasted") + ".txt", { type: "text/plain" }),
				)
				if (attach(dt.files)) e.preventDefault()
			})
			main.addEventListener("dragenter", (e) => {
				if (!e.dataTransfer.types.includes("Files")) return
				e.preventDefault()
			})
			main.addEventListener("dragover", (e) => {
				if (!e.dataTransfer.types.includes("Files")) return
				e.preventDefault()
			})
			main.addEventListener("drop", (e) => {
				if (!e.dataTransfer.types.includes("Files")) return
				e.preventDefault()
				const dt = new DataTransfer()
				for (const item of e.dataTransfer.items) {
					if (item.kind !== "file") continue
					const entry = item.webkitGetAsEntry()
					if (entry && entry.isDirectory) continue
					dt.items.add(item.getAsFile())
				}
				attach(dt.files)
			})
		</script>
	</div>
}

elem (c *chat) body(kind closedKind) {
	~(if kind == alive {
		<div class="nechat-log nechat-log_scroll" role="log" aria-label="Chat messages" tabindex="0" data-seeding="">
			~(c.list.Main())
			~(c.list.Script())
		</div>
		~composer.Composer{
			Controller: c.composer,
			Params: c.params,
			Pops: c.pops,
		}
	} else {
		<div class="nechat-closed-area">
			~(c.closed(kind))
		</div>
	})
}

elem (c *chat) closed(kind closedKind) {
	~~
	c.badge.Mutate(ctx, func(b Badge) Badge {
		return Badge{Collapsed: b.Collapsed, Block: "text", Ended: b.Ended, Failed: b.Failed}
	})
	icon, head, text := icons.WarningFill(), "Something went wrong", "This chat hit an error."
	if kind == deleted {
		icon, head, text = icons.Trash(), "This chat was deleted.", "It was deleted elsewhere."
	}
	if kind == tooLong {
		head, text = "This chat is too long", "It no longer fits the model's context window. Start a new chat to continue."
	}
	var once sync.Once
	confirm := func(ctx context.Context) {
		once.Do(func() {
			c.thread.Reload(ctx)
		})
	}
	~~
	<div class="nechat-closed-card" role="alert">
		~>(doors.Class("nechat-ic nechat-closed-ic")) ~(icon)
		<p class="nechat-closed-title">~(head)</p>
		<p class="nechat-closed-text">~(text)</p>
		<div class="nechat-closed-acts">
			~>doors.AClick{
				Scope: new(doors.ScopeBlocking),
				On: func(ctx context.Context, rp doors.RequestPointer) bool {
					confirm(ctx)
					return true
				},
				OnError: notify.OnError,
			} <button type="button" class="nechat-btn nechat-btn_auto">OK<i class="nechat-file-fill" aria-hidden="true"></i></button>
		</div>
		~(doors.Go(func(ctx context.Context) {
			select {
			case <-ctx.Done():
			case <-time.After(10 * time.Second):
				confirm(ctx)
			}
		}))
	</div>
}

elem title(name string) {
	<span class="nechat-top-title">~(name)</span>
}
