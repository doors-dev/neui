package rower

import (
	"context"
	
	"github.com/doors-dev/doors"
	"github.com/doors-dev/gox"
	"neui.dev/nekit/internal/chat/icons"
)

func newSlot(running gox.Elem) *doors.Door {
	slot := new(doors.Door)
	slot.Outer(context.Background(), running)
	return slot
}

elem notepadLines() {
	<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor">
		<path d="M212,64V208a16,16,0,0,1-16,16H56a16,16,0,0,1-16-16V64A16,16,0,0,1,56,48H88V40a8,8,0,0,1,16,0v8h48V40a8,8,0,0,1,16,0v8h32A16,16,0,0,1,216,64ZM56,64V208H200V64H168v8a8,8,0,0,1-16,0V64H104v8a8,8,0,0,1-16,0V64Z"></path>
		<path class="line" d="M168,112a8,8,0,0,1-8,8H96a8,8,0,0,1,0-16h64A8,8,0,0,1,168,112Z"></path>
		<path class="line" d="M160,136H96a8,8,0,0,0,0,16h64a8,8,0,0,0,0-16Z"></path>
	</svg>
}

elem textRunning() {
	~>(doors.Class("nechat-ic nechat-ic_line nechat-build")) ~(icons.TextAlignLeftLines())
}

elem textDone() {
	~>(doors.Class("nechat-ic")) ~(icons.TextAlignLeft())
}

elem thinkingRunning() {
	<span class="nechat-blink">
		~>(doors.Class("nechat-ic")) ~(icons.Lightbulb())
		~>(doors.Class("nechat-ic")) ~(icons.LightbulbFill())
	</span>
}

elem thinkingDone() {
	~>(doors.Class("nechat-ic")) ~(icons.Lightbulb())
}

elem summaryRunning() {
	~>(doors.Class("nechat-ic nechat-pulse")) ~(notepadLines())
}

elem summaryDone() {
	~>(doors.Class("nechat-ic")) ~(notepadLines())
}

elem toolsRunning() {
	~>(doors.Class("nechat-ic nechat-ic_spin")) ~(icons.Gear())
}

elem toolsDone() {
	~>(doors.Class("nechat-ic")) ~(icons.Terminal())
}

type block struct {
	title string
	icon any
	body any
}

elem (b block) Main() {
	<div class="nechat-blk">
		<div class="nechat-gut" title=(b.title)>~(b.icon)</div>
		~(b.body)
	</div>
}
