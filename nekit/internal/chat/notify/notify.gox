package notify

import (
	"context"
	"errors"
	
	"github.com/doors-dev/doors"
	"github.com/doors-dev/gox"
	"neui.dev/nekit/internal/chat/icons"
)

const event = "nechat_error"

var OnError doors.Actions = doors.ActionEmit[any]{Name: event}

func Error(ctx context.Context, err error) {
	k := kind(err)
	if k == "" || ctx.Err() != nil {
		return
	}
	doors.Call(ctx, doors.ActionEmit[any]{Name: event, Arg: k})
}

func kind(err error) string {
	if err == nil || errors.Is(err, context.Canceled) {
		return ""
	}
	return "server"
}

elem Script() {
	<script>
		const root = document.currentScript.closest(".nechat-widget")
		const timers = new Map()
		const show = (kind) => {
			let key = ""
			if (kind === "network") key = "network"
			else if (kind === "server" || kind === "other" || kind === "bad_request")
				key = "error"
			if (!key) return
			const box = root.querySelector(".nechat-toasts")
			if (!box) return
			let toast = box.querySelector(`.nechat-toast[data-key="${key}"]`)
			if (!toast) {
				toast = box
					.querySelector(`template[data-key="${key}"]`)
					.content.firstElementChild.cloneNode(true)
				box.append(toast)
			}
			clearTimeout(timers.get(key))
			timers.set(key, setTimeout(() => toast.remove(), 4000))
		}
		const listen = (e) => show(e.detail)
		root.addEventListener("nechat_error", listen)
		$sys.clean(() => root.removeEventListener("nechat_error", listen))
		$on("nechat_error", (arg, err) => show(err ? err.kind : arg))
	</script>
}

elem Toasts() {
	<div class="nechat-toasts" role="status" aria-live="polite">
		<template data-key="network">
			<div class="nechat-toast" data-key="network">
				<span class="nechat-toast-lead">~>(doors.Class("nechat-ic")) ~(icons.Prohibit())</span>
				<span class="nechat-toast-text">Network error occurred</span>
			</div>
		</template>
		<template data-key="error">
			<div class="nechat-toast" data-key="error" role="alert">
				<span class="nechat-toast-lead">~>(doors.Class("nechat-ic")) ~(icons.WarningFill())</span>
				<span class="nechat-toast-text">Something went wrong</span>
			</div>
		</template>
	</div>
}
