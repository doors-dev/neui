package chat

import (
	"context"
	"time"

	"github.com/doors-dev/doors"
	"github.com/doors-dev/gox"
	"neui.dev/api"
	"neui.dev/internal/instance"
	"neui.dev/nekit/internal/chat/aside"
	"neui.dev/nekit/internal/chat/chat"
	"neui.dev/nekit/internal/chat/css"
	"neui.dev/nekit/internal/chat/feature"
	"neui.dev/nekit/internal/chat/icons"
	"neui.dev/nekit/internal/chat/layout"
	"neui.dev/nekit/internal/chat/notify"
	"neui.dev/nekit/internal/chat/params"
	"neui.dev/nekit/internal/chat/pops"
)

type Chat struct {
	MaxAttachmentSize int
	MaxAttachments int
	AttachmentTimeout time.Duration
	AsideRight bool
	Framed bool
	ThemeDark css.Theme
	ThemeLight css.Theme
	Layout css.Layout
	GreetingTitle any
	GreetingBody any
	Disable []params.Feature
}

type windowStateWrapper struct {
	State *layout.State
}

type windowStateKey struct{}

func (k Chat) Main() gox.Elem {
	params := params.Params{
		MaxAttachmentSize: k.MaxAttachmentSize,
		MaxAttachments: k.MaxAttachments,
		AttachmentTimeout: k.AttachmentTimeout,
		AsideRight: k.AsideRight,
		Framed: k.Framed,
		ThemeDark: k.ThemeDark,
		ThemeLight: k.ThemeLight,
		Layout: k.Layout,
		GreetingTitle: k.GreetingTitle,
		GreetingBody: k.GreetingBody,
	}
	params.InitDefault()
	params.Disable(k.Disable)
	return gox.Elem(func(cur gox.Cursor) error {
		state := doors.TabState[windowStateWrapper](cur.Context(), "neui-chat")
		initlialized := false
		state.Sub(cur.Context(), func(ctx context.Context, ws *windowStateWrapper) bool {
			if ws == nil {
				return false
			}
			if !initlialized && ws.State != nil {
				initlialized = true
				return false
			}
			if initlialized {
				doors.SessionStore(ctx).Save(windowStateKey{}, *ws.State)
				return false
			}
			s, ok := doors.SessionStore(ctx).Load(windowStateKey{}).(layout.State)
			if !ok {
				s.Dock = params.Layout.Start == feature.Dock
			}
			s.Aside = false
			state.Update(ctx, &windowStateWrapper{State: &s})
			return false
		})
		inst := instance.GetInstance(cur.Context())
		enabled := doors.DeriveBeam(inst.State(), func(s api.InstanceState) bool {
			return s.Status != api.InstanceDisabled
		})
		if err := cur.Comp(css.Style(params.ThemeDark, params.ThemeLight, params.Layout)); err != nil {
			return err
		}
		return cur.Comp(state.Route(
			doors.RouteMatch(
				func(ws *windowStateWrapper) bool {
					return ws != nil && ws.State != nil
				},
				doors.RouteDerive(func(source doors.Source[*windowStateWrapper]) doors.Source[layout.State] {
					return doors.DeriveSource(source, func(w *windowStateWrapper) layout.State {
						if w == nil || w.State == nil {
							return layout.State{}
						}
						return *w.State
					}, func(_ *windowStateWrapper, w layout.State) *windowStateWrapper {
						return &windowStateWrapper{State: &w}
					})
				}, doors.RouteSource(elem(s doors.Source[layout.State]) {
					~~
					enabled, _ := enabled.Effect(ctx)
					if !enabled {
						return
					}
					locale, _ := doors.BrowserLocale(ctx).Effect(ctx)
					if !locale.Synced {
						return
					}
					~~
					~(&widget{
						params: params,
						state: s,
						inst: inst,
						pops: pops.NewPopups(),
					})
				})),
			),
		))
	})
}

type widget struct {
	params params.Params
	state doors.Source[layout.State]
	inst api.Instance
	pops pops.Popups
}

elem (k *widget) Main() {
	~~
	shell := new(doors.Setter)
	state, _ := k.state.Read(ctx)
	badge := doors.NewSource(chat.Badge{Collapsed: !state.Expanded, Block: "text"})
	mode, _ := doors.DeriveBeam(k.state, func(s layout.State) string {
		return layout.Mode(s, !k.params.Off(params.Float), !k.params.Off(params.Dock))
	}).ReadAndSub(ctx, func(ctx context.Context, m string) bool {
		doors.Call(ctx, shell.Set("data-mode", m))
		badge.Mutate(ctx, func(b chat.Badge) chat.Badge {
			b.Collapsed = m == "collapsed"
			if !b.Collapsed {
				b.Ended = false
				b.Failed = false
			}
			return b
		})
		return false
	})
	launcher := new(doors.Setter)
	label := func(b string) string {
		switch b {
		case "ask":
			return "Open chat, question for you"
		case "run-text", "run-thinking", "run-tools":
			return "Open chat, agent working"
		case "failed":
			return "Open chat, round failed"
		case "ended":
			return "Open chat, answer ready"
		}
		return "Open chat"
	}
	current, _ := doors.DeriveBeam(badge, func(b chat.Badge) string {
		switch {
		case b.Asking:
			return "ask"
		case b.Running:
			return "run-" + b.Block
		case b.Failed:
			return "failed"
		case b.Ended:
			return "ended"
		}
		return ""
	}).ReadAndSub(ctx, func(ctx context.Context, b string) bool {
		doors.Call(ctx, launcher.Set("data-badge", b))
		doors.Call(ctx, launcher.Set("aria-label", label(b)))
		return false
	})
	scope := new(doors.ScopeBlocking)
	toggle := doors.AClick{
		Scope: scope,
		On: func(ctx context.Context, _ doors.RequestPointer) bool {
			k.state.Mutate(ctx, func(s layout.State) layout.State {
				s.Expanded = !s.Expanded
				return s
			})
			return false
		},
		OnError: notify.OnError,
	}
	dock := doors.AClick{
		Scope: scope,
		On: func(ctx context.Context, _ doors.RequestPointer) bool {
			if k.params.Off(params.Float) || k.params.Off(params.Dock) {
				return false
			}
			k.state.Mutate(ctx, func(s layout.State) layout.State {
				s.Dock = !s.Dock
				return s
			})
			return false
		},
		OnError: notify.OnError,
	}
	dockIcon, undockIcon := icons.DockRight, icons.Undock
	if k.params.Layout.Side == css.Left {
		dockIcon, undockIcon = icons.DockLeft, icons.UndockLeft
	}
	~~
	<div
		(shell)
		data-mode=(mode)
		class=({
			class := "nechat-widget nechat-widget_split"
			if k.params.Off(params.Sidebar) {
				class += " nechat-widget_noside"
			} else if k.params.AsideRight {
				class += " nechat-widget_aside-right"
			}
			if k.params.Framed {
				class += " nechat-widget_frame"
			}
			return class
		})
		data-nechat-theme=({
			key := css.FaceKey(k.params.ThemeDark, k.params.ThemeLight)
			if key == "" {
				return nil
			}
			return key
		})
		data-nechat-layout=({
			key := css.LayoutKey(k.params.Layout)
			if key == "" {
				return nil
			}
			return key
		})>
		<div class="nechat-wctl">
			~(if !k.params.Off(params.Float) && !k.params.Off(params.Dock) {
				~>(dock) <button type="button" class="nechat-iconbtn nechat-wctl-dock" title="Dock to the side" aria-label="Dock to the side">
					~>(doors.Class("nechat-ic")) ~(dockIcon())
				</button>
				~>(dock) <button type="button" class="nechat-iconbtn nechat-wctl-undock" title="Undock" aria-label="Undock">
					~>(doors.Class("nechat-ic")) ~(undockIcon())
				</button>
			})
			~>(toggle) <button type="button" class="nechat-iconbtn nechat-wctl-collapse" title="Collapse" aria-label="Collapse">
				~>(doors.Class("nechat-ic")) ~(icons.Minus())
			</button>
		</div>
		~(if !k.params.Off(params.Sidebar) {
			~aside.Aside{
				Params: k.params,
				Instance: k.inst,
				Pops: k.pops,
				Layout: k.state,
			}
		})
		~chat.Chat{
			Params: k.params,
			Inst: k.inst,
			Pops: k.pops.Popup[string](),
			Badge: badge,
		}
		~(k.pops.Script())
		~(notify.Script())
		~>(toggle) <button
			type="button"
			class="nechat-launcher"
			title="Open chat"
			(launcher)
			data-badge=(current)
			aria-label=(label(current))>
			~>(doors.Class("nechat-ic")) ~(icons.ChatCircle())
			<span class="nechat-badge nechat-badge_run" aria-hidden="true">
				~>(doors.Class("nechat-ic nechat-ic_line nechat-build nechat-badge-text")) ~(icons.TextAlignLeftLines())
				<span class="nechat-blink nechat-badge-thinking">
					~>(doors.Class("nechat-ic")) ~(icons.Lightbulb())
					~>(doors.Class("nechat-ic")) ~(icons.LightbulbFill())
				</span>
				~>(doors.Class("nechat-ic nechat-ic_spin nechat-badge-tools")) ~(icons.Gear())
			</span>
			<span class="nechat-badge nechat-badge_ask" aria-hidden="true">
				~>(doors.Class("nechat-ic")) ~(icons.CheckSquareFill())
			</span>
			<span class="nechat-badge nechat-badge_ended" aria-hidden="true"></span>
			<span class="nechat-badge nechat-badge_failed" aria-hidden="true">
				~>(doors.Class("nechat-ic")) ~(icons.Exclamation())
			</span>
		</button>
		<script>
			const widget = document.currentScript.closest(".nechat-widget")
			const observer = new MutationObserver(() => {
				if (widget.dataset.mode === "collapsed") {
					widget.querySelector(".nechat-launcher").focus()
					return
				}
				widget.querySelector(".nechat-draft")?.focus({ preventScroll: true })
			})
			observer.observe(widget, { attributes: true, attributeFilter: ["data-mode"] })
			$sys.clean(() => observer.disconnect())
		</script>
	</div>
}
