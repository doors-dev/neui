package aside

import (
	"context"
	
	"github.com/doors-dev/doors"
	"github.com/doors-dev/gox"
	"neui.dev/api"
	chatmod "neui.dev/internal/modules/chat"
	"neui.dev/nekit/internal/chat/icons"
	"neui.dev/nekit/internal/chat/params"
	"neui.dev/nekit/internal/chat/notify"
)

type renameForm struct {
	Name string `form:"name"`
}

type row struct {
	aside *Aside
	thread api.Thread
	instance string
	day *doors.Door
}

elem (r *row) Main() {
	<div class="nechat-row">
		~(if !r.aside.Params.Off(params.ThreadEdit) {
			~(r.aside.menu.BindPop(chatMenu{id: r.thread.ID, mode: chatMenuOpen}, elem(hide func(context.Context)) {
				~(r.actions(hide))
			}))
			~(r.aside.menu.BindPop(chatMenu{id: r.thread.ID, mode: chatMenuRename}, elem(hide func(context.Context)) {
				~(r.rename(hide))
			}))
			~(r.aside.menu.BindPop(chatMenu{id: r.thread.ID, mode: chatMenuDelete}, elem(hide func(context.Context)) {
				~(r.confirm(hide))
			}))
		})
		~(r.open())
	</div>
}

elem (r *row) open() {
	~(if r.instance == r.aside.Instance.ID() {
		<div class="nechat-thread nechat-thread_active" aria-current="true">
			<span class="nechat-dot" aria-hidden="true"></span>
			~(name(r.thread.Name))
		</div>
	} else {
		~>doors.AClick{
			Scope: new(doors.ScopeBlocking),
			On: func(ctx context.Context, rp doors.RequestPointer) bool {
				if err := r.aside.Instance.ThreadOpen(ctx, r.thread.ID, nil); err != nil {
					doors.Logger(ctx).Error("aside: open", "thread", r.thread.ID, "err", err)
					notify.Error(ctx, err)
					return false
				}
				rp.After(doors.ActionEmit[any]{Name: "opened"})
				return false
			},
			OnError: notify.OnError,
		} <button class="nechat-thread">
			~(if r.instance == "" {
				<span class="nechat-dot nechat-dot_off" aria-hidden="true"></span>
			} else {
				<span class="nechat-dot" aria-hidden="true"></span>
			})
			~(name(r.thread.Name))
		</button>
	})
	~(if !r.aside.Params.Off(params.ThreadEdit) {
		~(r.aside.menu.BindControls(
			chatMenu{id: r.thread.ID, mode: chatMenuOpen},
			elem(show func(ctx context.Context)) {
				~(r.kebab(show))
			},
			elem(hide func(ctx context.Context)) {
				~(r.kebab(hide))
			},
		))
	})
}

elem (r *row) kebab(toggle func(ctx context.Context)) {
	~>doors.AClick{
		Scope: new(doors.ScopeBlocking),
		On: func(ctx context.Context, rp doors.RequestPointer) bool {
			toggle(ctx)
			return false
		},
		OnError: notify.OnError,
	} <button class="nechat-iconbtn" aria-label="Chat actions" aria-haspopup="menu">
		~>(doors.Class("nechat-ic")) ~(icons.DotsThreeVertical())
	</button>
}

elem (r *row) actions(hide func(ctx context.Context)) {
	<div class="nechat-rowmenu nechat-popbody" role="menu">
		~(r.action(icons.Pencil(), "Rename", func(ctx context.Context) {
			r.aside.menu.Show(ctx, chatMenu{id: r.thread.ID, mode: chatMenuRename})
		}))
		~(r.action(icons.Copy(), "Clone", func(ctx context.Context) {
			id, err := r.aside.Instance.ThreadClone(ctx, r.thread.ID)
			if err != nil {
				doors.Logger(ctx).Error("aside: clone", "thread", r.thread.ID, "err", err)
				notify.Error(ctx, err)
				hide(ctx)
				return
			}
			if err := r.aside.Instance.ThreadOpen(ctx, id, nil); err != nil {
				doors.Logger(ctx).Error("aside: open", "thread", id, "err", err)
				notify.Error(ctx, err)
			}
			hide(ctx)
		}))
		~(r.action(icons.Trash(), "Delete chat", func(ctx context.Context) {
			r.aside.menu.Show(ctx, chatMenu{id: r.thread.ID, mode: chatMenuDelete})
		}))
	</div>
}

elem (r *row) action(icon gox.Elem, label string, on func(ctx context.Context)) {
	~>doors.AClick{
		Scope: new(doors.ScopeBlocking),
		On: func(ctx context.Context, rp doors.RequestPointer) bool {
			on(ctx)
			return false
		},
		OnError: notify.OnError,
	} <button class="nechat-act" role="menuitem">
		~>(doors.Class("nechat-ic")) ~(icon)
		<span>~(label)</span>
	</button>
}

elem (r *row) rename(hide func(ctx context.Context)) {
	~>doors.ASubmit[renameForm]{
		Scope: new(doors.ScopeBlocking),
		On: func(ctx context.Context, rf doors.RequestForm[renameForm]) bool {
			n, err := chatmod.CheckName(rf.Data().Name)
			if err == nil && n != r.thread.Name {
				if err := r.aside.Instance.ThreadRename(ctx, r.thread.ID, n); err != nil {
					doors.Logger(ctx).Error("aside: rename", "thread", r.thread.ID, "err", err)
					notify.Error(ctx, err)
				} else {
					r.day.Reload(ctx)
				}
			}
			hide(ctx)
			return false
		},
		OnError: notify.OnError,
	} <form class="nechat-form" aria-label="Rename chat">
		<div class="nechat-form-field">
			~>doors.AKeyDown{
				Key: doors.Key{Key: "Escape"},
				Scope: new(doors.ScopeBlocking),
				On: func(ctx context.Context, rk doors.RequestKeyboard) bool {
					hide(ctx)
					return false
				},
				OnError: notify.OnError,
			} <input
				class="nechat-text"
				name="name"
				value=(r.thread.Name)
				maxlength="80"
				autofocus
				autocomplete="off"
				aria-label="Chat name"/>
			<script>
				const input = document.currentScript.previousElementSibling
				input.focus()
				input.setSelectionRange(input.value.length, input.value.length)
			</script>
		</div>
		<div class="nechat-form-actions">
			~>doors.AClick{
				Scope: new(doors.ScopeBlocking),
				On: func(ctx context.Context, rp doors.RequestPointer) bool {
					hide(ctx)
					return false
				},
				OnError: notify.OnError,
			} <button type="button" class="nechat-btn nechat-btn_2nd">Cancel</button>
			<button type="submit" class="nechat-btn">Save</button>
		</div>
	</form>
}

elem (r *row) confirm(hide func(ctx context.Context)) {
	~~
	label := r.thread.Name
	if label == "" {
		label = "Untitled"
	}
	~~
	<div class="nechat-form" role="group" aria-label="Delete chat">
		<div class="nechat-form-text">Delete <b>~(label)</b>?</div>
		<div class="nechat-form-actions">
			~>doors.AClick{
				Scope: new(doors.ScopeBlocking),
				On: func(ctx context.Context, rp doors.RequestPointer) bool {
					hide(ctx)
					return false
				},
				OnError: notify.OnError,
			} <button type="button" class="nechat-btn nechat-btn_2nd">Cancel</button>
			~>doors.AClick{
				Scope: new(doors.ScopeBlocking),
				On: func(ctx context.Context, rp doors.RequestPointer) bool {
					if err := r.aside.Instance.ThreadDelete(ctx, r.thread.ID); err != nil {
						doors.Logger(ctx).Error("aside: delete", "thread", r.thread.ID, "err", err)
						notify.Error(ctx, err)
					} else {
						r.day.Reload(ctx)
					}
					hide(ctx)
					return false
				},
				OnError: notify.OnError,
			} <button type="button" class="nechat-btn nechat-btn_del">Delete</button>
		</div>
	</div>
}
