package form

import (
	"context"
	"fmt"
	
	"github.com/doors-dev/gox"
	"neui.dev"
)

func newGroupWidget(ctx context.Context, group group, params groupParams) (*groupWidget, error) {
	base, err := group.newGroup(params.Name)
	if err != nil {
		return nil, err
	}
	_, item := group.(*listWidget)
	fields := make([]fieldWidget, 0, len(params.Fields))
	for _, field := range params.Fields {
		widget, err := newFieldWidget(ctx, base, field.v)
		if err != nil {
			return nil, err
		}
		fields = append(fields, widget)
	}
	return &groupWidget{
		item: item,
		params: params,
		group: base,
		fields: fields,
	}, nil
}

type groupWidget struct {
	item bool
	params groupParams
	group *groupBase
	fields []fieldWidget
}

func (f *groupWidget) name() string {
	return f.params.Name
}

func (f *groupWidget) init(ctx context.Context, value any) error {
	var values map[string]any
	if value != nil {
		v, ok := value.(map[string]any)
		if !ok {
			return fmt.Errorf("group %q: default value is %T, want an object", f.params.Name, value)
		}
		values = v
	}
	for _, field := range f.fields {
		if err := field.init(ctx, values[field.name()]); err != nil {
			return err
		}
	}
	return nil
}

func (f *groupWidget) destroy(ctx context.Context) {
	for _, field := range f.fields {
		field.destroy(ctx)
	}
	f.group.destroy(ctx)
}

elem (f *groupWidget) Main() {
	~(if f.item {
		~(for _, field := range f.fields {
			~(field)
		})
	} else {
		~>(neui.Space{Name: f.params.Name, Desc: f.params.Label}) <fieldset class="neisland-form-box">
			~(if f.params.Label != "" {
				<legend class="neisland-form-box-legend">~(f.params.Label)</legend>
			})
			<div class="neisland-form-rail">
				~(for _, field := range f.fields {
					~(field)
				})
			</div>
		</fieldset>
	})
}
