)

const overview = 5

elem (p *Aside) overview(input string, open func(ctx context.Context, kind controller.SearchKind)) {
	~~
	body := new(doors.Door)
	body.Inner(ctx, p.overviewBody(body, input, open))
	~~
	~(body)
}

elem (p *Aside) overviewBody(body *doors.Door, input string, open func(ctx context.Context, kind controller.SearchKind)) {
	~~
	loc := p.Instance.Location()
	current := p.Instance.State().Get().Thread.ID
	var failed error
	threads, err := p.Instance.ThreadList(ctx, time.Time{}, time.Time{}, false, overview + 1, input)
	if err != nil {
		doors.Logger(ctx).Error("aside: search names", "err", err)
		failed = err
	}
	mine, err := p.Instance.RoundSearch(ctx, current, false, input, nil, false, false, overview + 1)
	if err != nil {
		doors.Logger(ctx).Error("aside: search current", "err", err)
		failed = err
	}
	others, err := p.Instance.RoundSearch(ctx, current, true, input, nil, false, false, overview + 1)
	if err != nil {
		doors.Logger(ctx).Error("aside: search others", "err", err)
		failed = err
	}
	if failed != nil {
		notify.Error(ctx, failed)
	}
	~~
	~(if len(threads) != 0 {
		<div class="kchat-side-label">Chats</div>
		~(for _, t := range threads[:min(len(threads), overview)] {
			~(p.match(t))
		})
		~(if len(threads) > overview {
			~(p.more(open, controller.SearchNames))
		})
	})
	~(if len(mine) != 0 {
		<div class="kchat-side-label">Messages here</div>
		~(for _, h := range mine[:min(len(mine), overview)] {
			~(p.hit(h, loc, false))
		})
		~(if len(mine) > overview {
			~(p.more(open, controller.SearchMessagesCurrent))
		})
	})
	~(if len(others) != 0 {
		<div class="kchat-side-label">Other messages</div>
		~(for _, h := range others[:min(len(others), overview)] {
			~(p.hit(h, loc, true))
		})
		~(if len(others) > overview {
			~(p.more(open, controller.SearchMessagesAll))
		})
	})
	~(if failed != nil {
		~(retry(body))
	} else if len(threads) == 0 && len(mine) == 0 && len(others) == 0 {
		~(empty("No chats or messages match", "Try fewer words"))
	})
}

elem (p *Aside) noResults(kind controller.SearchKind) {
	~~
	text := "No chats or messages match"
	switch kind {
	case controller.SearchNames:
		text = "No chats match"
	case controller.SearchMessagesCurrent:
		text = "No messages in this chat match"
	case controller.SearchMessagesAll:
		text = "No messages in other chats match"
	}
	~~
	~(empty(text, ""))
}

elem retry(door *doors.Door) {
	<div class="kchat-side-retry" role="alert">
		<span>Couldn't load.</span>
		~>doors.AClick{
			Scope: new(doors.ScopeBlocking),
			On: func(ctx context.Context, rp doors.RequestPointer) bool {
				door.Reload(ctx)
				return false
			},
			OnError: notify.OnError,
		} <button type="button" class="kchat-btn kchat-btn_2nd">Retry</button>
	</div>
}

elem empty(text string, hint string) {
	<div class="kchat-side-empty">
		<div>~(text)</div>
		~(if hint != "" {
			<div class="kchat-side-empty-hint">~(hint)</div>
		})
	</div>
}

elem (p *Aside) more(open func(ctx context.Context, kind controller.SearchKind), kind controller.SearchKind) {
	<div class="kchat-row">
		~>doors.AClick{
			Scope: new(doors.ScopeBlocking),
			On: func(ctx context.Context, rp doors.RequestPointer) bool {
				open(ctx, kind)
				return false
			},
			OnError: notify.OnError,
		} <button class="kchat-thread kchat-thread_new">
			~>(doors.Class("kchat-ic")) ~(icons.ArrowRight())
			<span class="kchat-thread-name">Show more</span>
		</button>
	</div>
}

elem (p *Aside) hit(h api.Hit, loc *time.Location, named bool) {
	~>doors.AClick{
		Scope: new(doors.ScopeBlocking),
		On: func(ctx context.Context, rp doors.RequestPointer) bool {
			if err := p.Instance.ThreadOpen(ctx, h.Thread, anchor.NewAnchor(h.Round)); err != nil {
				doors.Logger(ctx).Error("aside: open", "thread", h.Thread, "err", err)
				notify.Error(ctx, err)
				return false
			}
			rp.After(doors.ActionEmit[any]{Name: "opened"})
			return false
		},
		OnError: notify.OnError,
	} <button class="kchat-hit">
		~(if named {
			<span class="kchat-hit-head">
				~(p.hitName(h))
				<span class="kchat-date">~(shortDate(h.Created, loc))</span>
			</span>
			<span class="kchat-hit-snippet">~(h.Snippet)</span>
		} else {
			<span class="kchat-date kchat-date_over">~(shortDate(h.Created, loc))</span>
			<span class="kchat-hit-snippet kchat-hit-snippet_under">~(h.Snippet)</span>
		})
	</button>
}

elem (p *Aside) hitName(h api.Hit) {
	~~
	t, err := p.Instance.ThreadGet(ctx, h.Thread)
	if err != nil {
		doors.Logger(ctx).Error("aside: hit thread", "thread", h.Thread, "err", err)
	}
	n := t.Name
	if n == "" {
		n = "Untitled"
	}
	~~
	<span class="kchat-hit-name">~(n)</span>
}

type hits struct {
	aside *Aside
	window controller.Window
	save func(ctx context.Context, w controller.Window)
	thread api.ThreadID
	exclude bool
	query string
}

elem (h *hits) Main() {
	~(&window.WindowList{
		Margin: margin,
		Driver: h,
		InitialWindow: h.window,
		SaveWindow: h.save,
	})
}

func (h *hits) Compare(a string, b string) int {
	x, y := hitCursor(a), hitCursor(b)
	if x == nil || y == nil {
		return strings.Compare(a, b)
	}
	if c := x.Created.Compare(y.Created); c != 0 {
		return c
	}
	if c := strings.Compare(string(x.Thread), string(y.Thread)); c != 0 {
		return c
	}
	return cmp.Compare(x.Round, y.Round)
}

func (h *hits) Sections(ctx context.Context, from string, inclusive bool, asc bool, limit int) ([]window.Section, bool, error) {
	found, err := h.aside.Instance.RoundSearch(ctx, h.thread, h.exclude, h.query, hitCursor(from), inclusive, asc, limit)
	if err != nil {
		return nil, false, err
	}
	out := make([]window.Section, 0, len(found))
	for _, f := range found {
		out = append(out, window.Section{
			Key: strconv.FormatInt(f.Created.UnixNano(), 10) + ":" + strconv.Itoa(int(f.Round)) + ":" + string(f.Thread),
			Content: &hitRow{hits: h, hit: f},
		})
	}
	return out, len(found) < limit, nil
}

func hitCursor(key string) *api.Cursor {
	parts := strings.SplitN(key, ":", 3)
	if len(parts) != 3 {
		return nil
	}
	at, _ := strconv.ParseInt(parts[0], 10, 64)
	round, _ := strconv.Atoi(parts[1])
	return &api.Cursor{
		Created: time.Unix(0, at),
		Thread: api.ThreadID(parts[2]),
		Round: api.RoundID(round),
	}
}

type hitRow struct {
	hits *hits
	hit api.Hit
}

elem (r *hitRow) Main() {
	~(r.hits.aside.hit(r.hit, r.hits.aside.Instance.Location(), r.hits.exclude))
}

func shortDate(t time.Time, loc *time.Location) string {
	u := t.In(loc)
	if u.Year() == time.Now().In(loc).Year() {
		return u.Format("Jan 2")
	}
	return u.Format("Jan 2, 2006")
}

func todayIn(loc *time.Location) time.Time {
	now := time.Now().In(loc)
	y, m, day := now.Date()
	return time.Date(y, m, day, 0, 0, 0, 0, loc)
}

type names struct {
	aside *Aside
	window controller.Window
	save func(ctx context.Context, w controller.Window)
	query string
}

elem (n *names) Main() {
	~(&days{aside: n.aside, window: n.window, save: n.save, name: n.query})
}
