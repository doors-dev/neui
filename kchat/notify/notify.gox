package notify

import (
	"context"
	"errors"
	
	"github.com/doors-dev/doors"
	"github.com/doors-dev/gox"
	"neui.dev/kchat/icons"
)

const event = "kchat_error"

var OnError doors.Actions = doors.ActionEmit[any]{Name: event}

type rootKey struct{}

func Root(ctx context.Context) context.Context {
	return context.WithValue(ctx, rootKey{}, doors.DetachedContext(ctx))
}

func Error(ctx context.Context, err error) {
	root, ok := ctx.Value(rootKey{}).(context.Context)
	k := kind(err)
	if !ok || k == "" {
		return
	}
	doors.Call(root, doors.ActionEmit[any]{Name: event, Arg: k})
}

func kind(err error) string {
	if err == nil || errors.Is(err, context.Canceled) {
		return ""
	}
	return "server"
}

elem Script() {
	<script>
		const root = document.currentScript.closest(".kchat-widget")
		const show = (kind) => {
			let key = ""
			if (kind === "network") key = "network"
			else if (kind === "server" || kind === "other" || kind === "bad_request")
				key = "error"
			if (!key) return
			const box = root.querySelector(".kchat-toasts")
			if (!box) return
			const shown = box.querySelector(`.kchat-toast[data-key="${key}"]`)
			if (shown) {
				for (const el of [shown, ...shown.querySelectorAll(".kchat-file-fill")]) {
					el.style.animation = "none"
					void el.offsetWidth
					el.style.animation = ""
				}
				return
			}
			const toast = box
				.querySelector(`template[data-key="${key}"]`)
				.content.firstElementChild.cloneNode(true)
			toast.addEventListener("animationend", (e) => {
				if (e.target === toast) toast.remove()
			})
			box.append(toast)
		}
		const listen = (e) => show(e.detail)
		root.addEventListener("kchat_error", listen)
		$sys.clean(() => root.removeEventListener("kchat_error", listen))
		$on("kchat_error", (arg, err) => show(err ? err.kind : arg))
	</script>
}

elem Toasts() {
	<div class="kchat-toasts" role="status" aria-live="polite">
		<template data-key="network">
			<div class="kchat-toast" data-key="network">
				<span class="kchat-toast-lead">~>(doors.Class("kchat-ic")) ~(icons.Prohibit())</span>
				<span class="kchat-toast-text">Network error occurred</span>
				<i class="kchat-file-fill" aria-hidden="true"></i>
			</div>
		</template>
		<template data-key="error">
			<div class="kchat-toast" data-key="error" role="alert">
				<span class="kchat-toast-lead">~>(doors.Class("kchat-ic")) ~(icons.WarningFill())</span>
				<span class="kchat-toast-text">Something went wrong</span>
				<i class="kchat-file-fill" aria-hidden="true"></i>
			</div>
		</template>
	</div>
}
