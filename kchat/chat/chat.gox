package chat

import (
	"context"
	
	"github.com/doors-dev/doors"
	"github.com/doors-dev/gox"
	"neui.dev/api"
	"neui.dev/kchat/anchor"
	"neui.dev/kchat/chat/composer"
	"neui.dev/kchat/chat/composer/controller"
	"neui.dev/kchat/icons"
	"neui.dev/kchat/chat/list"
	"neui.dev/kchat/pops"
	"neui.dev/kchat/params"
)

type Chat struct {
	Params params.Params
	Inst api.Instance
	Pops pops.Popup[string]
}

const pasteAsFile = 64 * 1024

func (c Chat) Main() gox.Elem {
	return c.Inst.Render(c)
}

func (c Chat) Chat(thread api.ChatThread, s api.ChatState) api.Chat {
	controller := controller.NewComposerController(thread, s.Input, s.Round != nil, s.Usage, s.Tasks, s.Compaction, s.Ask)
	at := anchor.Read(s.Meta)
	return &chat{
		params: c.Params,
		thread: thread,
		inst: c.Inst,
		composer: controller,
		pops: c.Pops,
		list: list.NewList(c.Params, c.Inst, thread, controller, s.ID, s.Round, at),
		name: doors.NewSource(s.Name),
	}
}

elem (c Chat) Placeholder(enabled doors.Beam[bool]) {
	~(enabled.Bind(elem(loading bool) {
		<div
			class="kchat-pane kchat-widget_off"
			aria-disabled="true"
			aria-busy=({
				if loading {
					return "true"
				}
				return "false"
			})>
			<div class="kchat-top"></div>
			<div class="kchat-log kchat-log_scroll" role="log" aria-label="Chat messages"></div>
			<div class="kchat-composer">
				<div class="kchat-tray">
				</div>
				<textarea class="kchat-draft" rows="2" disabled></textarea>
				<div class="kchat-barrow">
					<div class="kchat-barrow-left">
						~(if !c.Params.Off(params.Attachments) {
							<button class="kchat-iconbtn" disabled>
								~>(doors.Class("kchat-ic")) ~(icons.Attach())
							</button>
						})
					</div>
					<div class="kchat-barrow-right">
						<button class="kchat-iconbtn" disabled>
							~>(doors.Class("kchat-ic")) ~(icons.Submit())
						</button>
					</div>
				</div>
			</div>
		</div>
	}))
}

type chat struct {
	params params.Params
	thread api.ChatThread
	inst api.Instance
	composer controller.ComposerController
	pops pops.Popup[string]
	list list.List
	name doors.Source[string]
}

func (c *chat) Update(ctx context.Context, e api.ChatEvent) {
	doors.OnBatch(ctx, func(context.Context) {}, func(ctx context.Context) {
		if api.Final(e) {
			c.composer.UpdateActive(ctx, false)
		}
		switch e := e.(type) {
		case api.ChatEventName:
			c.name.Update(ctx, e.Name)
		case api.ChatEventRoundEnd:
			c.composer.RoundDone(ctx, e.State, e.Usage)
			c.list.RoundDone(ctx, e.State, e.Error)
		case api.ChatEventRoundStart:
			c.composer.UpdateActive(ctx, true)
			if e.Round.Input.Len() != 0 {
				c.composer.FlushInput(ctx)
			}
			c.list.RoundStart(ctx, e.Round, e.Truncate)
		case api.ChatEventInputPending:
			c.composer.UpdatePending(ctx, e.Pending)
		case api.ChatEventTasks:
			c.composer.UpdateTasks(ctx, e.Tasks)
		case api.ChatEventCompacting:
			c.composer.UpdateCompaction(ctx, e.Running, e.Usage)
		case api.ChatEventRoundUsage:
			c.composer.UpdateUsage(ctx, e.Usage)
		case api.ChatEventAsk:
			c.composer.Ask(ctx, e.Ask)
		case api.ChatEventAskDone:
			c.composer.AskDone(ctx)
		case api.ChatEventIndexed:
			c.list.IndexedEvent(e.Event)
		case api.ChatEventToolResults:
			c.list.ToolsDone()
		}
	})
}

elem (c *chat) Main() {
	~>doors.AKeyDown{
		Key: doors.Key{Key: "Escape"},
		Scope: new(doors.ScopeBlocking),
		On: func(ctx context.Context, rk doors.RequestKeyboard) bool {
			c.composer.Escape(ctx)
			return false
		},
	} <div
		class="kchat-pane"
		data-attach=({
			if c.params.Off(params.Attachments) {
				return "off"
			}
			return nil
		})>
		<div class="kchat-top kchat-top_menu">
			~(c.name.Bind(title))
			~(if !c.params.Off(params.Files) {
				~(c.files())
			})
		</div>
		<div class="kchat-log kchat-log_scroll" role="log" aria-label="Chat messages" data-seeding="">
			~(c.list.Main())
			~(c.list.Script())
		</div>
		~composer.Composer{
			Controller: c.composer,
			Params: c.params,
			Pops: c.pops,
		}
		<script data:id=(c.params.ID) data:paste=(pasteAsFile)>
			const main = document.currentScript.parentElement
			const id = $data("id")
			const pasteAsFile = $data("paste")
			const attach = (files) => {
				const composer = main.querySelector("#composer" + id)
				if (!composer || composer.getAttribute("aria-busy") === "true") return false
				const input = main.querySelector("#attach" + id + " input")
				if (!input || !files.length) return false
				input.files = files
				input.dispatchEvent(new Event("change"))
				return true
			}
			main.addEventListener("paste", (e) => {
				const files = e.clipboardData.files
				if (files.length) {
					if (attach(files)) e.preventDefault()
					return
				}
				const text = e.clipboardData.getData("text/plain")
				if (main.dataset.attach === "off") return
				if (!text || new TextEncoder().encode(text).length <= pasteAsFile) return
				const head = text.slice(0, 64).split("\n", 1)[0]
				const base = head
					.replace(/[\\/:*?"<>|\x00-\x1f]+/g, " ")
					.replace(/\s+/g, " ")
					.replace(/^[.\s]+/, "")
					.trim()
					.slice(0, 40)
				const dt = new DataTransfer()
				dt.items.add(
					new File([text], (base || "pasted") + ".txt", { type: "text/plain" }),
				)
				if (attach(dt.files)) e.preventDefault()
			})
			main.addEventListener("dragenter", (e) => {
				if (!e.dataTransfer.types.includes("Files")) return
				e.preventDefault()
			})
			main.addEventListener("dragover", (e) => {
				if (!e.dataTransfer.types.includes("Files")) return
				e.preventDefault()
			})
			main.addEventListener("drop", (e) => {
				if (!e.dataTransfer.types.includes("Files")) return
				e.preventDefault()
				const dt = new DataTransfer()
				for (const item of e.dataTransfer.items) {
					if (item.kind !== "file") continue
					const entry = item.webkitGetAsEntry()
					if (entry && entry.isDirectory) continue
					dt.items.add(item.getAsFile())
				}
				attach(dt.files)
			})
		</script>
	</div>
}

elem title(name string) {
	~(if name == "" {
		<span class="kchat-top-title kchat-top-title_quiet">New Chat</span>
	} else {
		<span class="kchat-top-title">~(name)</span>
	})
}
