package uploader

import (
	"context"
	"io"
	"mime/multipart"
	"net/http"
	"path"
	"strconv"
	"strings"
	"sync"
	"sync/atomic"
	"time"
	
	"github.com/doors-dev/doors"
	"github.com/doors-dev/gox"
	"neui.dev/api"
	"neui.dev/kchat/icons"
	"neui.dev/kchat/params"
)

func fileIcon(mime string) gox.Elem {
	switch {
	case strings.HasPrefix(mime, "image/"):
		return icons.FileImage()
	case strings.HasPrefix(mime, "text/"), mime == "application/json", mime == "application/xml":
		return icons.FileText()
	case mime == "application/zip", mime == "application/gzip", mime == "application/x-tar", mime == "application/x-7z-compressed":
		return icons.FileArchive()
	default:
		return icons.File()
	}
}

type fileList interface {
	add(ctx context.Context, filename string)
	remove(ctx context.Context, filename string)
}

func newFileDone(fs api.FS, list fileList, name string, p params.Params) fileDone {
	f := fileDone{
		fs: fs,
		door: new(doors.Door),
		name: name,
		list: list,
		params: p,
	}
	f.door.Outer(context.Background(), f.main())
	return f
}

type fileDone struct {
	fs api.FS
	door *doors.Door
	name string
	list fileList
	params params.Params
}

elem (f fileDone) Main() {
	~(f.door)
}

elem (f fileDone) main() {
	~~
	entry, err := f.fs.UploadStat(ctx, f.name)
	~~
	~(if err != nil {
		~~
		f.list.remove(ctx, f.name)
		~~
		~(fileErr{
			door: f.door,
			name: f.name,
			text: describe(ctx, err, f.params),
		}.main())
	} else {
		<span class="kchat-file kchat-file_done" title=(entry.MIME)>
			~>(doors.Class("kchat-ic")) ~(fileIcon(entry.MIME))
			<span class="kchat-file-name">~(path.Base(f.name))</span>
			<span class="kchat-file-trail">
				~>doors.AClick{
					Scope: new(doors.ScopeBlocking),
					On: func(ctx context.Context, rp doors.RequestPointer) bool {
						f.list.remove(ctx, f.name)
						f.door.Static(ctx, nil)
						return true
					},
				} <button class="kchat-ctl" aria-label=("Remove " + path.Base(f.name))>
					~>(doors.Class("kchat-ic")) ~(icons.Close())
				</button>
			</span>
		</span>
	})
}

func newFileProgress(fs api.FS, list fileList, r doors.RequestRawHook, name string, total int64, p params.Params) *fileProgress {
	ctx, cancel := context.WithCancel(r.Context())
	f := &fileProgress{
		list: list,
		door: new(doors.Door),
		fs: fs,
		name: name,
		percent: doors.NewSource(0),
		ctx: ctx,
		cancel: cancel,
		total: total,
		params: p,
		w: r.ResponseWriter(),
	}
	f.door.Outer(context.Background(), f.main())
	return f
}

type progressStatus int
const (
	downloding progressStatus = iota
	done
	errored
	canceled
)

type fileProgress struct {
	mu sync.Mutex
	entry *api.FSEntry
	status progressStatus
	fs api.FS
	list fileList
	door *doors.Door
	name string
	percent doors.Source[int]
	cancel context.CancelFunc
	ctx context.Context
	total int64
	params params.Params
	w http.ResponseWriter
}

type countingReader struct {
	r io.Reader
	limit int64
	read atomic.Int64
}

func (c *countingReader) Read(b []byte) (int, error) {
	n, err := c.r.Read(b)
	if c.read.Add(int64(n)) > c.limit {
		return n, api.ErrTooLarge
	}
	return n, err
}

const progressTick = time.Second / 2

func (f *fileProgress) track(ctx context.Context, counter *countingReader) {
	if f.total <= 0 {
		return
	}
	ticker := time.NewTicker(progressTick)
	defer ticker.Stop()
	last := 0
	for {
		select {
		case <-f.ctx.Done():
			return
		case <-ticker.C:
			percent := int(min(counter.read.Load() * 100 / f.total, 99))
			if percent != last {
				last = percent
				f.percent.Update(ctx, percent)
			}
		}
	}
}

func (f *fileProgress) download(ctx context.Context, part *multipart.Part) (added bool, err error) {
	defer f.cancel()
	counter := &countingReader{r: part, limit: int64(f.params.MaxAttachmentSize)}
	go f.track(ctx, counter)
	entry, err := f.fs.UserUpload(f.ctx, f.name, counter)
	f.mu.Lock()
	if err != nil {
		defer f.mu.Unlock()
		f.w.Header().Set("Connection", "close")
		if f.status == canceled {
			f.w.WriteHeader(http.StatusRequestTimeout)
			return false, err
		}
		f.status = errored
		f.w.WriteHeader(http.StatusInternalServerError)
		f.intoError(ctx, describe(ctx, err, f.params))
		return false, err
	}
	if f.status == canceled {
		f.mu.Unlock()
		f.fs.DeleteUpload(ctx, entry.Name)
		return false, nil
	}
	f.status = done
	f.entry = &entry
	f.mu.Unlock()
	f.list.add(ctx, f.entry.Name)
	f.intoDone(ctx)
	return true, nil
}

elem (f *fileProgress) Main() {
	~(f.door)
}
elem (f *fileProgress) main() {
	<span class="kchat-file">
		~(f.percent.Bind(elem(i int) {
			<i class="kchat-file-fill" style=("width:" + strconv.Itoa(i) + "%") aria-hidden="true"></i>
		}))
		~>(doors.Class("kchat-ic")) ~(icons.File())
		<span class="kchat-file-name">~(path.Base(f.name))</span>
		~(f.percent.Bind(elem(i int) {
			<span class="kchat-file-meta">~(i)%</span>
		}))
		<span class="kchat-file-trail">
			~>doors.AClick{
				Scope: new(doors.ScopeBlocking),
				On: func(ctx context.Context, rp doors.RequestPointer) bool {
					f.mu.Lock()
					remove := f.status == done
					if f.status == downloding {
						f.status = canceled
						f.cancel()
					}
					f.mu.Unlock()
					if remove {
						f.list.remove(ctx, f.entry.Name)
					}
					f.door.Static(ctx, nil)
					return true
				},
			} <button class="kchat-ctl" aria-label="Cancel upload">
				~>(doors.Class("kchat-ic")) ~(icons.Close())
			</button>
		</span>
	</span>
}

func (f *fileProgress) intoDone(ctx context.Context) {
	ef := &fileDone{
		fs: f.fs,
		door: f.door,
		list: f.list,
		name: f.entry.Name,
		params: f.params,
	}
	f.door.Outer(ctx, ef.main())
}

func (f *fileProgress) intoError(ctx context.Context, text string) {
	ef := &fileErr{
		door: f.door,
		name: f.name,
		text: text,
	}
	f.door.Outer(ctx, ef.main())
}

type fileErr struct {
	door *doors.Door
	name string
	text string
}

func newFileErr(ctx context.Context, name string, err error, p params.Params) fileErr {
	f := fileErr{
		door: new(doors.Door),
		name: name,
		text: describe(ctx, err, p),
	}
	f.door.Outer(context.Background(), f.main())
	return f
}

elem (f fileErr) Main() {
	~(f.door)
}

elem (f fileErr) main() {
	<span class="kchat-file kchat-file_err" title=(f.text)>
		~>(doors.Class("kchat-ic")) ~(icons.WarningFill())
		<span class="kchat-file-name">~(path.Base(f.name))</span>
		<span class="kchat-file-meta">~(f.text)</span>
		<span class="kchat-file-trail">
			~>doors.AClick{
				Scope: new(doors.ScopeBlocking),
				On: func(ctx context.Context, rp doors.RequestPointer) bool {
					f.door.Static(ctx, nil)
					return true
				},
			} <button class="kchat-ctl" aria-label="Dismiss">
				~>(doors.Class("kchat-ic")) ~(icons.Close())
			</button>
		</span>
	</span>
}
