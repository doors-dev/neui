package uploader

import (
	"errors"
	"io"
	"net/http"
	"path"
	"strconv"
	
	"github.com/doors-dev/doors"
	"github.com/doors-dev/gox"
	"neui.dev/api"
	"neui.dev/kchat/icons"
)

// Sent is an attachment of a sent message: a chip that downloads the file on
// click, or an error chip when the file can no longer be read.
type Sent struct {
	FS api.FS
	Name string
}

elem (s Sent) Main() {
	~~
	entry, err := s.FS.UploadStat(ctx, s.Name)
	text := ""
	if err != nil {
		text = "file unavailable"
		if errors.Is(err, api.ErrNotFound) {
			text = "file is gone"
		} else {
			doors.Logger(ctx).Error("kchat: sent file", "name", s.Name, "err", err)
		}
	}
	~~
	~(if err != nil {
		<span class="kchat-file kchat-file_err" title=(text)>
			~>(doors.Class("kchat-ic")) ~(icons.WarningFill())
			<span class="kchat-file-name">~(path.Base(s.Name))</span>
			<span class="kchat-file-meta">~(text)</span>
		</span>
	} else {
		<a class="kchat-file kchat-file_done" title=(entry.MIME) href=(download(s.FS, s.Name)) download=(path.Base(s.Name))>
			~>(doors.Class("kchat-ic")) ~(fileIcon(entry.MIME))
			<span class="kchat-file-name">~(path.Base(s.Name))</span>
		</a>
	})
}

func download(fs api.FS, name string) doors.Resource {
	return doors.ResourceHandler(func(w http.ResponseWriter, r *http.Request) {
		e, err := fs.UploadStat(r.Context(), name)
		if err != nil || e.Dir {
			http.NotFound(w, r)
			return
		}
		rc, err := fs.ReadAll(r.Context(), name)
		if err != nil {
			http.NotFound(w, r)
			return
		}
		defer rc.Close()
		w.Header().Set("X-Content-Type-Options", "nosniff")
		w.Header().Set("Content-Security-Policy", "sandbox")
		if e.MIME != "" {
			w.Header().Set("Content-Type", e.MIME)
		}
		if e.Size > 0 {
			w.Header().Set("Content-Length", strconv.FormatInt(e.Size, 10))
		}
		w.Header().Set("Content-Disposition", "attachment; filename=" + strconv.Quote(path.Base(name)))
		io.Copy(w, rc)
	})
}
