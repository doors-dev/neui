package chat

import (
	"context"
	"fmt"
	"io"
	"net/http"
	"path"
	"slices"
	"strconv"
	"strings"
	"time"
	
	"github.com/doors-dev/doors"
	"github.com/doors-dev/gox"
	"neui.dev/api"
	"neui.dev/kchat/icons"
	"neui.dev/kchat/notify"
)

elem (c *chat) files() {
	~(doors.DeriveBeam(c.dead, func(k closedKind) bool {
		return k != alive
	}).Bind(elem(dead bool) {
		~(if dead {
			<button class="kchat-iconbtn" title="Files" aria-label="Files" disabled>
				~>(doors.Class("kchat-ic")) ~(icons.Files())
			</button>
		} else {
			~(c.pops.BindControls("files",
				elem(show func(ctx context.Context)) {
					~(filesButton(show, false))
				},
				elem(hide func(ctx context.Context)) {
					~(filesButton(hide, true))
				},
			))
		})
	}))
	~(c.pops.BindPop("files", elem(hide func(context.Context)) {
		~(&fileList{fs: c.thread.FS(), loc: c.inst.Location()})
	}))
}

elem filesButton(toggle func(ctx context.Context), open bool) {
	~~
	class := "kchat-iconbtn"
	if open {
		class = "kchat-iconbtn kchat-iconbtn_open"
	}
	~~
	~>doors.AClick{
		Scope: new(doors.ScopeBlocking),
		On: func(ctx context.Context, rp doors.RequestPointer) bool {
			toggle(ctx)
			return false
		},
		OnError: notify.OnError,
	} <button class=(class) title="Files" aria-label="Files">
		~>(doors.Class("kchat-ic")) ~(icons.Files())
	</button>
}

type fileList struct {
	fs api.FS
	loc *time.Location
	body *doors.Door
}

elem (l *fileList) Main() {
	~~
	l.body = new(doors.Door)
	l.body.Inner(ctx, l.content())
	~~
	<div class="kchat-rowmenu kchat-popbody kchat-files">
		~(l.body)
	</div>
}

elem (l *fileList) content() {
	~~
	// drafts are what the composer is still holding, and the uploads dirs
	// already hide them, so a listing is exactly what was sent or produced
	entries := []api.FSEntry{}
	for _, dir := range []string{api.UserUploadsDir, api.AgentUploadsDir} {
		found, err := l.fs.ReadDir(ctx, dir)
		if err != nil {
			doors.Logger(ctx).Error("kchat: files", "dir", dir, "err", err)
			continue
		}
		entries = append(entries, found...)
	}
	slices.SortFunc(entries, func(a api.FSEntry, b api.FSEntry) int {
		return b.ModTime.Compare(a.ModTime)
	})
	~~
	~(if len(entries) == 0 {
		<div class="kchat-side-empty">
			<div>No files yet</div>
			<div class="kchat-side-empty-hint">Attachments and anything the agent saves show up here</div>
		</div>
	} else {
		<div class="kchat-pop-group">
			~(for _, e := range entries {
				~(l.row(e))
			})
		</div>
	})
}

elem (l *fileList) row(e api.FSEntry) {
	~~
	name := path.Base(e.Name)
	del := doors.NewSource(false)
	~~
	~(del.Bind(elem(asking bool) {
		~(if asking {
			<div class="kchat-form" role="group" aria-label="Delete file">
				<div class="kchat-form-text">Delete <b>~(name)</b>?</div>
				<div class="kchat-form-actions">
					~>doors.AClick{
						Scope: new(doors.ScopeBlocking),
						On: func(ctx context.Context, rp doors.RequestPointer) bool {
							del.Update(ctx, false)
							return false
						},
						OnError: notify.OnError,
					} <button type="button" class="kchat-btn kchat-btn_2nd">Cancel</button>
					~>doors.AClick{
						Scope: new(doors.ScopeBlocking),
						On: func(ctx context.Context, rp doors.RequestPointer) bool {
							if err := l.fs.DeleteUpload(ctx, e.Name); err != nil {
								doors.Logger(ctx).Error("kchat: file delete", "name", e.Name, "err", err)
								notify.Error(ctx, err)
							}
							l.body.Reload(ctx)
							return false
						},
						OnError: notify.OnError,
					} <button type="button" class="kchat-btn kchat-btn_del">Delete</button>
				</div>
			</div>
		} else {
			<div class="kchat-entry">
				~>(doors.Class("kchat-ic")) ~(if strings.HasPrefix(e.Name, api.UserUploadsDir + "/") {
					~(icons.UploadSimple())
				} else {
					~(icons.DownloadSimple())
				})
				<span class="kchat-entry-body">
					<a class="kchat-entry-name" href=(download(l.fs, e.Name)) download=(name) title=(name)>~(name)</a>
					<span class="kchat-entry-detail">~(size(e.Size) + " · " + when(e.ModTime, l.loc))</span>
				</span>
				~>doors.AClick{
					Scope: new(doors.ScopeBlocking),
					On: func(ctx context.Context, rp doors.RequestPointer) bool {
						del.Update(ctx, true)
						return false
					},
					OnError: notify.OnError,
				} <button class="kchat-ctl" aria-label=("Delete " + name)>
					~>(doors.Class("kchat-ic")) ~(icons.Trash())
				</button>
			</div>
		})
	}))
}

func size(n int64) string {
	switch {
	case n >= 1 << 20:
		return fmt.Sprintf("%.1f MB", float64(n) / (1 << 20))
	case n >= 1 << 10:
		return fmt.Sprintf("%d KB", n >> 10)
	default:
		return fmt.Sprintf("%d B", n)
	}
}

func when(t time.Time, loc *time.Location) string {
	u := t.In(loc)
	now := time.Now().In(loc)
	y, m, d := now.Date()
	if u.After(time.Date(y, m, d, 0, 0, 0, 0, loc)) {
		return u.Format("15:04")
	}
	if u.Year() == now.Year() {
		return u.Format("Jan 2")
	}
	return u.Format("Jan 2, 2006")
}

func download(fs api.FS, name string) doors.Resource {
	return doors.ResourceHandler(func(w http.ResponseWriter, r *http.Request) {
		e, err := fs.UploadStat(r.Context(), name)
		if err != nil || e.Dir {
			http.NotFound(w, r)
			return
		}
		rc, err := fs.ReadAll(r.Context(), name)
		if err != nil {
			http.NotFound(w, r)
			return
		}
		defer rc.Close()
		if e.MIME != "" {
			w.Header().Set("Content-Type", e.MIME)
		}
		if e.Size > 0 {
			w.Header().Set("Content-Length", strconv.FormatInt(e.Size, 10))
		}
		w.Header().Set("Content-Disposition", "attachment; filename=" + strconv.Quote(path.Base(name)))
		io.Copy(w, rc)
	})
}
