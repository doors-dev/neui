{
  "model": "gpt-5.6-sol",
  "stream": true,
  "stream_options": {
    "include_obfuscation": false
  },
  "store": false,
  "include": [
    "reasoning.encrypted_content"
  ],
  "tools": [
    {
      "type": "function",
      "name": "lookup",
      "description": "Look a word up.",
      "parameters": {
        "properties": {
          "q": {
            "type": "string"
          }
        },
        "required": [
          "q"
        ],
        "type": "object"
      }
    },
    {
      "type": "function",
      "name": "clock",
      "description": "Read the time.",
      "parameters": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      }
    }
  ],
  "input": [
    {
      "role": "user",
      "content": [
        {
          "type": "input_text",
          "text": "look up cat"
        }
      ]
    },
    {
      "type": "function_call",
      "call_id": "call_1",
      "name": "lookup",
      "arguments": "{}"
    },
    {
      "type": "function_call_output",
      "call_id": "call_1",
      "output": [
        {
          "type": "input_text",
          "text": "Error:"
        },
        {
          "type": "input_text",
          "text": "tool call arguments were not valid JSON, the call was not made, reissue it with complete arguments: {\"q\":"
        }
      ]
    }
  ]
}
