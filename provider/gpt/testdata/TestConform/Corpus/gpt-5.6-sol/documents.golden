{
  "model": "gpt-5.6-sol",
  "stream": true,
  "stream_options": {
    "include_obfuscation": false
  },
  "store": false,
  "include": [
    "reasoning.encrypted_content"
  ],
  "input": [
    {
      "role": "user",
      "content": [
        {
          "type": "input_text",
          "text": "summarize these"
        },
        {
          "type": "input_file",
          "filename": "a.pdf",
          "file_data": "data:application/pdf;base64,JVBERi0xLjQKJeLjz9MK"
        },
        {
          "type": "input_file",
          "filename": "b.txt",
          "file_data": "data:text/plain;base64,cGxhaW4gd29yZHM="
        }
      ]
    }
  ]
}
