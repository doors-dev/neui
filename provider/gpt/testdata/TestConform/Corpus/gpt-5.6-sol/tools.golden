{
  "model": "gpt-5.6-sol",
  "stream": true,
  "stream_options": {
    "include_obfuscation": false
  },
  "store": false,
  "include": [
    "reasoning.encrypted_content"
  ],
  "tools": [
    {
      "type": "function",
      "name": "lookup",
      "description": "Look a word up.",
      "parameters": {
        "properties": {
          "q": {
            "type": "string"
          }
        },
        "required": [
          "q"
        ],
        "type": "object"
      }
    },
    {
      "type": "function",
      "name": "clock",
      "description": "Read the time.",
      "parameters": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      }
    }
  ],
  "input": [
    {
      "role": "user",
      "content": [
        {
          "type": "input_text",
          "text": "look up cat"
        }
      ]
    },
    {
      "role": "assistant",
      "content": [
        {
          "type": "input_text",
          "text": "Looking."
        }
      ]
    },
    {
      "type": "function_call",
      "call_id": "call_1",
      "name": "lookup",
      "arguments": "{\"q\":\"cat\"}"
    },
    {
      "type": "function_call_output",
      "call_id": "call_1",
      "output": [
        {
          "type": "input_text",
          "text": "a small feline"
        }
      ]
    }
  ]
}
