{
  "model": "gpt-5.6-sol",
  "stream": true,
  "stream_options": {
    "include_obfuscation": false
  },
  "store": false,
  "include": [
    "reasoning.encrypted_content"
  ],
  "input": [
    {
      "role": "user",
      "content": [
        {
          "type": "input_text",
          "text": "hi"
        }
      ]
    },
    {
      "role": "assistant",
      "content": [
        {
          "type": "output_text",
          "text": "[reasoning omitted]"
        },
        {
          "type": "output_text",
          "text": "hello"
        }
      ]
    },
    {
      "role": "user",
      "content": [
        {
          "type": "input_text",
          "text": "again"
        }
      ]
    }
  ]
}
