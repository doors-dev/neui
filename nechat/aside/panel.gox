package aside

import (
	"context"
	"strconv"
	"time"
	
	"github.com/doors-dev/doors"
	"github.com/doors-dev/gox"
	"neui.dev/api"
	"neui.dev/nechat/aside/controller"
	"neui.dev/nechat/pops"
	"neui.dev/nechat/icons"
	"neui.dev/nechat/params"
	"neui.dev/nechat/notify"
)

type chatMenuMode int

const (
	chatMenuNone chatMenuMode = iota
	chatMenuOpen
	chatMenuRename
	chatMenuDelete
)

type chatMenu struct {
	id api.ThreadID
	mode chatMenuMode
}

type Aside struct {
	Params params.Params
	Instance api.Instance
	Pops pops.Popups
	menu pops.Popup[chatMenu]
	controller controller.Controller
}

elem (p Aside) Main() {
	~~
	p.controller = controller.New(p.Params.Off(params.MessageSearch))
	p.menu = p.Pops.Popup[chatMenu]()
	burger := new(doors.Setter)
	expanded, _ := p.controller.Expanded().ReadAndSub(ctx, func(ctx context.Context, v bool) bool {
		doors.Call(ctx, burger.Set("aria-expanded", strconv.FormatBool(v)))
		return false
	})
	~~
	~(p.controller.Show(p.aside()))
	~>doors.AClick{
		Scope: new(doors.ScopeBlocking),
		On: func(ctx context.Context, rp doors.RequestPointer) bool {
			p.controller.Toggle(ctx)
			return false
		},
		OnError: notify.OnError,
	} <button class="nechat-iconbtn nechat-burger" title="Menu" (burger) aria-expanded=(strconv.FormatBool(expanded))>
		~(p.controller.RouteToggle(
			<>~>(doors.Class("nechat-ic")) ~(icons.List())</>,
			<>~>(doors.Class("nechat-ic")) ~(icons.Close())</>,
			<>~>(doors.Class("nechat-ic")) ~(icons.ArrowLeft())</>,
		))
	</button>
}

elem (p *Aside) aside() {
	<aside class="nechat-aside">
		<div class="nechat-top" role="search">
			<label class="nechat-field">
				~>(doors.Class("nechat-ic-sm")) ~(icons.MagnifyingGlass())
				~(p.controller.Input(elem(v string) {
					~>doors.AInput{
						Scope: &doors.ScopeDebounce{
							Duration: time.Second / 5,
							Limit: time.Second / 3,
						},
						Race: doors.RaceStrict,
						On: func(ctx context.Context, ri doors.RequestInput) bool {
							p.controller.SearchInput(ctx, ri.Event().Value)
							return false
						},
						OnError: notify.OnError,
					} <input
						value=(v)
						class="nechat-text"
						type="search"
						placeholder="Search"
						aria-label="Search chats"/>
				}))
			</label>
		</div>
		<div class="nechat-side-body">
			~(p.controller.RouteList(
				elem(w controller.Window, set func(ctx context.Context, w controller.Window)) {
					~(&days{aside: p, window: w, save: set})
				},
				elem(input string, open func(ctx context.Context, kind controller.SearchKind)) {
					~(p.overview(input, open))
				},
				elem(input string, w controller.Window, set func(ctx context.Context, w controller.Window)) {
					~(if input == "" {
						~(p.noResults(controller.SearchNames))
					} else {
						~(&names{aside: p, query: input, window: w, save: set})
					})
				},
				elem(input string, w controller.Window, set func(ctx context.Context, w controller.Window)) {
					~(if input == "" {
						~(p.noResults(controller.SearchMessagesCurrent))
					} else {
						~(&hits{aside: p, thread: p.Instance.State().Get().Thread.ID, query: input, window: w, save: set})
					})
				},
				elem(input string, w controller.Window, set func(ctx context.Context, w controller.Window)) {
					~(if input == "" {
						~(p.noResults(controller.SearchMessagesAll))
					} else {
						~(&hits{aside: p, thread: p.Instance.State().Get().Thread.ID, exclude: true, query: input, window: w, save: set})
					})
				},
			))
		</div>
		~>doors.AHook[bool]{
			Name: "collapse",
			Scope: new(doors.ScopeBlocking),
			On: func(ctx context.Context, r doors.RequestHook[bool]) (any, bool) {
				p.controller.Collapse(ctx)
				return nil, false
			},
		} <script>
			const side = document.currentScript.closest(".nechat-aside")
			const widget = side.closest(".nechat-widget")
			$on("opened", () => {
				if (getComputedStyle(side).position !== "absolute") return
				return $hook("collapse", true).catch((err) => {
					if (err instanceof HookErr)
						widget.dispatchEvent(new CustomEvent("nechat_error", { detail: err.kind }))
				})
			})
		</script>
		~(if !p.Params.Off(params.ThreadEdit) {
			<script>
				const side = document.currentScript.closest(".nechat-aside")
				let timer = null
				let fired = false
				const cancel = () => {
					clearTimeout(timer)
					timer = null
				}
				side.addEventListener(
					"touchstart",
					(e) => {
						const row = e.target.closest(".nechat-row")
						if (!row) return
						fired = false
						timer = setTimeout(() => {
							timer = null
							const kebab = row.querySelector(".nechat-iconbtn")
							if (!kebab) return
							fired = true
							kebab.click()
						}, 500)
					},
					{ passive: true },
				)
				side.addEventListener("touchmove", cancel, { passive: true })
				side.addEventListener("touchend", cancel, { passive: true })
				side.addEventListener("touchcancel", cancel, { passive: true })
				side.addEventListener(
					"click",
					(e) => {
						if (!fired) return
						fired = false
						if (e.target.closest(".nechat-rowmenu")) return
						e.preventDefault()
						e.stopPropagation()
					},
					true,
				)
			</script>
		})
	</aside>
}

elem (p *Aside) match(t api.Thread) {
	<div class="nechat-row">
		~>doors.AClick{
			Scope: new(doors.ScopeBlocking),
			On: func(ctx context.Context, rp doors.RequestPointer) bool {
				if err := p.Instance.ThreadOpen(ctx, t.ID, nil); err != nil {
					doors.Logger(ctx).Error("aside: open", "thread", t.ID, "err", err)
					notify.Error(ctx, err)
					return false
				}
				rp.After(doors.ActionEmit[any]{Name: "opened"})
				return false
			},
			OnError: notify.OnError,
		} <button class="nechat-thread">
			<span class="nechat-dot nechat-dot_off" aria-hidden="true"></span>
			~(name(t.Name))
			<span class="nechat-date">~(shortDate(t.Updated, p.Instance.Location()))</span>
		</button>
	</div>
}

elem name(n string) {
	~(if n == "" {
		<span class="nechat-thread-name">Untitled</span>
	} else {
		<span class="nechat-thread-name">~(n)</span>
	})
}
