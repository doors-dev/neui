package main

import (
	"context"
	"fmt"
	"time"

	"github.com/doors-dev/doors"
	"github.com/doors-dev/gox"
	"neui.dev"
)

elem orderPage(id int) {
	~>(new(doors.Door)) ~({
		_, ok := shop.version.Effect(ctx)
		if !ok {
			return nil
		}
		o, found := shop.Order(id)
		if !found {
			return notFound(fmt.Sprintf("Order #%d", id), crumb{Label: "Back to orders", Model: OrdersPath{}})
		}
		c, _ := shop.Customer(o.CustomerID)
		return orderView(o, c)
	})
}

elem orderView(o order, c customerRow) {
	~~
	open := o.Status == paid || o.Status == unpaid
	~~
	~>neui.Space{
		Name: "order",
		Desc: fmt.Sprintf("Page of order #%d: its items, shipping address, customer, payment status and refund or cancel", o.ID),
	} <div>
		~neui.Data{Text: "the order on this page", Object: o}
		~pageHeader{
			Crumbs: []crumb{{Label: "Orders", Model: OrdersPath{}}, {Label: fmt.Sprintf("#%d", o.ID), Model: OrderPath{ID: o.ID}}},
			Title: fmt.Sprintf("Order #%d", o.ID),
			Meta: <>
				~(badge(o.Status))
				<span>~("Placed ", o.Date)</span>
				~(if o.Status == unpaid {
					<span class=(opt(when(overdue(o), "font-medium text-red-700")))>~("Due ", o.Due)</span>
				})
				<span>~(money(o.Total))</span>
			</>,
			Actions: <>
				~(if open {
					~>neui.Use{Desc: "open the edit form of this order"} <a
						(doors.ALink{Model: OrderPath{View: ItemEdit, ID: o.ID}, Batch: true, After: scrollTop})
						class=(btnSecondary)>
						~(icon(iconEdit, "size-4"))
						Edit order
					</a>
				})
			</>,
		}
		<div class="grid grid-cols-1 gap-6 @4xl:grid-cols-3">
			<div class="space-y-6 @4xl:col-span-2">
				~>neui.Space{Name: "items", Desc: "Products on the order with quantities and amounts"} <div>
					~card{
						Title: "Items",
						Flush: true,
						Body: orderLines(o),
					}
				</div>
				~>neui.Space{Name: "shipping", Desc: "Where the order ships"} <div>
					~card{
						Title: "Shipping",
						Body: <>
							<p class="text-sm whitespace-pre-line text-stone-900">~(o.Address)</p>
							~(if open {
								<p class="mt-2 text-sm text-stone-500">Wrong address? Fix it with Edit order.</p>
							})
						</>,
					}
				</div>
			</div>
			<div class="space-y-6">
				~>neui.Space{Name: "customer", Desc: "Who placed the order"} ~card{
					Title: "Customer",
					Body: <>
						~>neui.Use{Desc: "open the page of customer " + c.Name} <a
							(doors.ALink{Model: CustomerPath{ID: c.ID}, Batch: true, After: scrollTop})
							class=(linkText)>
							~(c.Name)
						</a>
						~(if c.Company != "" {
							<p class="mt-0.5 text-sm text-stone-500">~(c.Company)</p>
						})
						<div class="mt-3 space-y-1 text-sm text-stone-600">
							<p>~(c.Email)</p>
							~(if c.Phone != "" {
								<p>~(c.Phone)</p>
							})
						</div>
						<p class="mt-3 text-xs text-stone-500">~(c.Orders, " order", plural(c.Orders), " · ", money(c.Spent), " paid")</p>
					</>,
				}
				~>neui.Space{Name: "actions", Desc: "Payment status and what can still be done with the order: refund a paid one, cancel an unpaid one"} <div>
					~card{Title: "Actions", Body: orderActions(o)}
				</div>
			</div>
		</div>
	</div>
}

elem orderLines(o order) {
	<div class="overflow-x-auto">
		<table class=(tableClass)>
			<thead>
				<tr>
					<th class=(thClass)>Product</th>
					<th class=(thClass.Add("text-right"))>Qty</th>
					<th class=(thClass.Add("hidden text-right @xl:table-cell"))>Unit price</th>
					<th class=(thClass.Add("text-right"))>Amount</th>
				</tr>
			</thead>
			<tbody>
				~(for _, l := range o.Lines {
					<tr class="border-t border-stone-100">
						<td class=(tdClass)>
							~>neui.Use{Desc: "open product " + l.Name} <a (doors.ALink{Model: ProductPath{ID: l.ProductID}, Batch: true, After: scrollTop}) class="font-medium text-stone-900 hover:underline">
								~(l.Name)
							</a>
							<p class="text-xs text-stone-500">~(l.SKU)</p>
						</td>
						<td class=(tdClass.Add("text-right tabular-nums"))>~(l.Qty)</td>
						<td class=(tdClass.Add("hidden text-right text-stone-500 tabular-nums @xl:table-cell"))>~(money(l.Price))</td>
						<td class=(tdClass.Add("text-right tabular-nums"))>~(money(float64(l.Qty) * l.Price))</td>
					</tr>
				})
			</tbody>
			<tfoot>
				<tr class="border-t border-stone-200 bg-stone-50/60">
					<td class=(tdClass.Add("font-medium")) colspan="2">Total</td>
					<td class=(tdClass.Add("hidden @xl:table-cell"))></td>
					<td class=(tdClass.Add("text-right text-base font-semibold tabular-nums"))>~(money(o.Total))</td>
				</tr>
			</tfoot>
		</table>
	</div>
}

elem orderActions(o order) {
	~(if o.Status == paid {
		<>
			<p class="mb-3 text-sm text-stone-500">Paid in full. A refund returns ~(money(o.Total)) to the customer.</p>
			~confirmAction{
				Label: "Refund order",
				Icon: iconMoney,
				Desc: "start a refund of this order; Confirm refund in the confirmation completes it",
				Question: fmt.Sprintf("Refund %s to %s?", money(o.Total), o.Customer),
				Detail: "The money goes back to the customer's card. This can't be undone.",
				Confirm: "Confirm refund",
				Full: true,
				ConfirmDesc: "refund this order now; it can't be undone",
				Do: func(ctx context.Context) error {
					_, err := refundOrder(ctx, orderInput{Order: o.ID})
					return err
				},
			}
		</>
	} else if o.Status == unpaid {
		<>
			<p class="mb-3 text-sm text-stone-500">
				~("Not paid yet, due ", shortDate(o.Due), ". Mark it paid in Edit order, or cancel it to put the items back in stock.")
			</p>
			~(if o.Reminded != "" {
				<p class="mb-3 flex items-center gap-1.5 text-sm text-stone-600">
					~(icon(iconClock, "size-4 text-stone-400"))
					~("Reminder sent ", shortDate(o.Reminded))
				</p>
			})
			~confirmAction{
				Label: "Cancel order",
				Icon: iconClose,
				Desc: "start cancelling this order; Cancel order in the confirmation completes it",
				Question: fmt.Sprintf("Cancel order #%d?", o.ID),
				Detail: "Its items go back into stock. A cancelled order can't be reopened.",
				Confirm: "Cancel order",
				Full: true,
				ConfirmDesc: "cancel this order now; it can't be undone",
				Do: func(ctx context.Context) error {
					_, err := cancelOrder(ctx, orderInput{Order: o.ID})
					return err
				},
			}
		</>
	} else {
		<p class="text-sm text-stone-500">
			This order is ~(string(o.Status)) and closed. Nothing more can be done with it.
		</p>
	})
}

func overdue(o order) bool {
	return o.Status == unpaid && o.Due < time.Now().Format(time.DateOnly)
}
