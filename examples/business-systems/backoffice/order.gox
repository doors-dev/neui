package main

import (
	"context"
	"errors"
	"fmt"
	"slices"
	"strconv"
	"strings"

	"github.com/doors-dev/doors"
	"github.com/doors-dev/gox"
	"neui.dev"
)

elem orderPage(id int) {
	~>(new(doors.Door)) ~({
		_, ok := shop.version.Effect(ctx)
		if !ok {
			return nil
		}
		o, found := shop.Order(id)
		if !found {
			return notFound(fmt.Sprintf("Order #%d", id), crumb{Label: "Back to orders", Model: OrdersPath{}})
		}
		c, _ := shop.Customer(o.CustomerID)
		return orderView(o, c)
	})
}

type statusInput struct {
	Status string `json:"status" required:"true" description:"paid or unpaid"`
}

type addressInput struct {
	Address string `json:"address" description:"new shipping address; empty for the customer's address on file"`
}

type removeItemInput struct {
	Product int `json:"product" required:"true" description:"product id of the item to take off"`
}

elem orderView(o order, c customerRow) {
	~~
	open := o.Status == paid || o.Status == unpaid
	~~
	~>neui.Space{
		Name: "order",
		Desc: fmt.Sprintf("Page of order #%d: its items, shipping address, customer, payment status and refund or cancel", o.ID),
	} <div>
		~neui.Data{Text: "the order on this page", Object: o}
		~pageHeader{
			Crumbs: []crumb{{Label: "Orders", Model: OrdersPath{}}, {Label: fmt.Sprintf("#%d", o.ID), Model: OrderPath{ID: o.ID}}},
			Title: fmt.Sprintf("Order #%d", o.ID),
			Meta: <>
				~(badge(o.Status))
				<span>~("Placed ", o.Date)</span>
				<span>~(money(o.Total))</span>
			</>,
			Actions: <>
				~(if open {
					~>neui.Use{Desc: "open the edit form of this order"} <a
						(doors.ALink{Model: OrderPath{View: ItemEdit, ID: o.ID}, Batch: true, After: scrollTop})
						class=(btnSecondary)>
						~(icon(iconEdit, "size-4"))
						Edit order
					</a>
				})
			</>,
		}
		<div class="grid grid-cols-1 gap-6 @4xl:grid-cols-3">
			<div class="space-y-6 @4xl:col-span-2">
				~>neui.Space{Name: "items", Desc: "Products on the order with quantities and amounts"} <div>
					~(if open {
						~neui.Tool[itemInput, struct{}]{
							Name: "add_item",
							Desc: "Add a product to this order; when it is already on the order, its quantity grows by qty. Checked against stock like the edit form",
							Handler: func(ctx context.Context, in itemInput) (struct{}, error) {
								line := 0
								err := shop.ChangeOrder(ctx, o.ID, func(f *orderForm) error {
									if in.Qty < 1 {
										return fmt.Errorf("qty must be at least 1")
									}
									product := strconv.Itoa(in.Product)
									i := slices.IndexFunc(f.Lines, func(l lineForm) bool {
										return l.Product == product
									})
									if i < 0 {
										line = len(f.Lines)
										f.Lines = append(f.Lines, lineForm{Product: product, Qty: strconv.Itoa(in.Qty)})
										return nil
									}
									line = i
									qty, _ := strconv.Atoi(f.Lines[i].Qty)
									f.Lines[i].Qty = strconv.Itoa(qty + in.Qty)
									return nil
								})
								if err != nil {
									return struct{}{}, errors.New(strings.ReplaceAll(err.Error(), "lines."+strconv.Itoa(line)+".", ""))
								}
								notify(ctx, fmt.Sprintf("Order #%d: item added", o.ID))
								return struct{}{}, nil
							},
						}
						~neui.Tool[removeItemInput, struct{}]{
							Name: "remove_item",
							Desc: "Take a product off this order and put its units back in stock; an order keeps at least one item",
							Handler: func(ctx context.Context, in removeItemInput) (struct{}, error) {
								err := shop.ChangeOrder(ctx, o.ID, func(f *orderForm) error {
									product := strconv.Itoa(in.Product)
									if !slices.ContainsFunc(f.Lines, func(l lineForm) bool {
										return l.Product == product
									}) {
										return fmt.Errorf("product %d is not on order #%d", in.Product, o.ID)
									}
									f.Lines = slices.DeleteFunc(f.Lines, func(l lineForm) bool {
										return l.Product == product
									})
									return nil
								})
								if err != nil {
									return struct{}{}, err
								}
								notify(ctx, fmt.Sprintf("Order #%d: item removed", o.ID))
								return struct{}{}, nil
							},
						}
					})
					~card{
						Title: "Items",
						Flush: true,
						Body: orderLines(o),
					}
				</div>
				~>neui.Space{Name: "shipping", Desc: "Where the order ships"} <div>
					~(if open {
						~neui.Tool[addressInput, struct{}]{
							Name: "update_shipping_address",
							Desc: "Change where this order ships",
							Handler: func(ctx context.Context, in addressInput) (struct{}, error) {
								err := shop.ChangeOrder(ctx, o.ID, func(f *orderForm) error {
									f.Address = in.Address
									return nil
								})
								if err != nil {
									return struct{}{}, err
								}
								notify(ctx, fmt.Sprintf("Order #%d: shipping address saved", o.ID))
								return struct{}{}, nil
							},
						}
					})
					~card{
						Title: "Shipping",
						Body: <>
							<p class="text-sm whitespace-pre-line text-stone-900">~(o.Address)</p>
							~(if open {
								<p class="mt-2 text-sm text-stone-500">Wrong address? Fix it with Edit order.</p>
							})
						</>,
					}
				</div>
			</div>
			<div class="space-y-6">
				~>neui.Space{Name: "customer", Desc: "Who placed the order"} ~card{
					Title: "Customer",
					Body: <>
						~>neui.Use{Desc: "open the page of customer " + c.Name} <a
							(doors.ALink{Model: CustomerPath{ID: c.ID}, Batch: true, After: scrollTop})
							class=(linkText)>
							~(c.Name)
						</a>
						~(if c.Company != "" {
							<p class="mt-0.5 text-sm text-stone-500">~(c.Company)</p>
						})
						<div class="mt-3 space-y-1 text-sm text-stone-600">
							<p>~(c.Email)</p>
							~(if c.Phone != "" {
								<p>~(c.Phone)</p>
							})
						</div>
						<p class="mt-3 text-xs text-stone-500">~(c.Orders, " order", plural(c.Orders), " · ", money(c.Spent), " paid")</p>
					</>,
				}
				~>neui.Space{Name: "actions", Desc: "Payment status and what can still be done with the order: refund a paid one, cancel an unpaid one"} <div>
					~(if open {
						~neui.Tool[statusInput, struct{}]{
							Name: "set_status",
							Desc: "Mark this order paid or unpaid. Refunded and cancelled are not statuses to set: the refund and cancel buttons here open a confirmation only the user can press",
							Handler: func(ctx context.Context, in statusInput) (struct{}, error) {
								err := shop.ChangeOrder(ctx, o.ID, func(f *orderForm) error {
									f.Status = in.Status
									return nil
								})
								if err != nil {
									return struct{}{}, err
								}
								notify(ctx, fmt.Sprintf("Order #%d marked %s", o.ID, in.Status))
								return struct{}{}, nil
							},
						}
					})
					~card{Title: "Actions", Body: orderActions(o)}
				</div>
			</div>
		</div>
	</div>
}

elem orderLines(o order) {
	<div class="overflow-x-auto">
		<table class=(tableClass)>
			<thead>
				<tr>
					<th class=(thClass)>Product</th>
					<th class=(thClass.Add("text-right"))>Qty</th>
					<th class=(thClass.Add("hidden text-right @xl:table-cell"))>Unit price</th>
					<th class=(thClass.Add("text-right"))>Amount</th>
				</tr>
			</thead>
			<tbody>
				~(for _, l := range o.Lines {
					<tr class="border-t border-stone-100">
						<td class=(tdClass)>
							~>neui.Use{Desc: "open product " + l.Name} <a (doors.ALink{Model: ProductPath{ID: l.ProductID}, Batch: true, After: scrollTop}) class="font-medium text-stone-900 hover:underline">
								~(l.Name)
							</a>
							<p class="text-xs text-stone-500">~(l.SKU)</p>
						</td>
						<td class=(tdClass.Add("text-right tabular-nums"))>~(l.Qty)</td>
						<td class=(tdClass.Add("hidden text-right text-stone-500 tabular-nums @xl:table-cell"))>~(money(l.Price))</td>
						<td class=(tdClass.Add("text-right tabular-nums"))>~(money(float64(l.Qty) * l.Price))</td>
					</tr>
				})
			</tbody>
			<tfoot>
				<tr class="border-t border-stone-200 bg-stone-50/60">
					<td class=(tdClass.Add("font-medium")) colspan="2">Total</td>
					<td class=(tdClass.Add("hidden @xl:table-cell"))></td>
					<td class=(tdClass.Add("text-right text-base font-semibold tabular-nums"))>~(money(o.Total))</td>
				</tr>
			</tfoot>
		</table>
	</div>
}

elem orderActions(o order) {
	~(if o.Status == paid {
		<>
			<p class="mb-3 text-sm text-stone-500">Paid in full. A refund returns ~(money(o.Total)) to the customer.</p>
			~confirmAction{
				Label: "Refund order",
				Icon: iconMoney,
				Desc: "start a refund of this order; the user must then confirm it on the page",
				Question: fmt.Sprintf("Refund %s to %s?", money(o.Total), o.Customer),
				Detail: "The money goes back to the customer's card. This can't be undone.",
				Confirm: "Confirm refund",
				Full: true,
				Wait: "The refund waits for the user: only they can press Confirm refund. Ask them to confirm it on the page.",
				Do: func(ctx context.Context) error {
					if err := shop.Refund(ctx, o.ID); err != nil {
						return err
					}
					notify(ctx, fmt.Sprintf("Order #%d refunded", o.ID))
					return nil
				},
			}
		</>
	} else if o.Status == unpaid {
		<>
			<p class="mb-3 text-sm text-stone-500">Not paid yet. Mark it paid in Edit order, or cancel it to put the items back in stock.</p>
			~confirmAction{
				Label: "Cancel order",
				Icon: iconClose,
				Desc: "start cancelling this order; the user must then confirm it on the page",
				Question: fmt.Sprintf("Cancel order #%d?", o.ID),
				Detail: "Its items go back into stock. A cancelled order can't be reopened.",
				Confirm: "Cancel order",
				Full: true,
				Wait: "Cancelling waits for the user: only they can press Cancel order in the confirmation. Ask them to confirm it on the page.",
				Do: func(ctx context.Context) error {
					if err := shop.Cancel(ctx, o.ID); err != nil {
						return err
					}
					notify(ctx, fmt.Sprintf("Order #%d cancelled", o.ID))
					return nil
				},
			}
		</>
	} else {
		<p class="text-sm text-stone-500">
			This order is ~(string(o.Status)) and closed. Nothing more can be done with it.
		</p>
	})
}
