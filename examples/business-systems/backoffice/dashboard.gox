package main

import (
	"fmt"
	"time"

	"github.com/doors-dev/doors"
	"github.com/doors-dev/gox"
	"neui.dev"
)

elem dashboardPage() {
	~~
	architect := neui.Tier(ctx) == neui.TierArchitect
	desc := "Dashboard: this month's numbers, recent orders and products running low"
	if architect {
		desc = "Dashboard: this month's numbers, recent orders, products running low and a report panel"
	}
	~~
	~>neui.Space{Name: "dashboard", Desc: desc} <div>
		~pageHeader{
			Title: "Dashboard",
			Meta: <span>~(time.Now().Format("Monday, January 2"))</span>,
			Actions: <>
				~>neui.Use{Desc: "open the form to create a new order"} <a (doors.ALink{Model: OrdersPath{View: ListNew}, Batch: true, After: scrollTop}) class=(btnPrimary)>
					~(icon(iconPlus, "size-4"))
					New order
				</a>
			</>,
		}
		~>(new(doors.Door)) ~({
			_, ok := shop.version.Effect(ctx)
			if !ok {
				return nil
			}
			return dashboardBody(shop.Stats(), shop.Orders(orderQuery{}))
		})
		~(if architect {
			<div class="mt-6">~(reportPanel())</div>
		})
	</div>
}

elem dashboardBody(st stats, orders []order) {
	~~
	recent := orders[:min(6, len(orders))]
	change := ""
	if st.RevenuePrev > 0 {
		change = fmt.Sprintf("%+.0f%% vs last month", (st.Revenue - st.RevenuePrev) / st.RevenuePrev * 100)
	}
	~~
	~>neui.Space{
		Name: "numbers",
		Desc: "This month's numbers; the unpaid and low stock cards link to the matching lists",
	} <div class="grid grid-cols-2 gap-3 @xl:gap-4 @4xl:grid-cols-4">
		~neui.Data{Text: "numbers shown on the dashboard", Object: st}
		~(kpi("Revenue this month", money(st.Revenue), change, iconMoney, nil, ""))
		~(kpi("Orders this month", fmt.Sprint(st.Orders), "not counting cancelled", iconOrders, nil, ""))
		~(kpi("Unpaid orders", fmt.Sprint(st.Unpaid), money(st.UnpaidAmount) + " outstanding", iconClock, OrdersPath{Status: string(unpaid)}, "show the unpaid orders"))
		~(kpi("Low stock", fmt.Sprint(len(st.LowStock)), fmt.Sprintf("%d or fewer units left", lowStock), iconProducts, ProductsPath{Sort: "stock"}, "show the products by stock, lowest first"))
	</div>
	<div class="mt-6 grid grid-cols-1 gap-6 @4xl:grid-cols-3">
		~>neui.Space{Name: "recent_orders", Desc: "The six newest orders, linking to each order and its customer"} <div class="@4xl:col-span-2">
			~card{
				Title: "Recent orders",
				Flush: true,
				Actions: <>
					~>neui.Use{Desc: "go to the full orders list"} <a (doors.ALink{Model: OrdersPath{}, Batch: true, After: scrollTop}) class="text-sm font-medium text-amber-700 hover:text-amber-900">
						View all
					</a>
				</>,
				Body: <div class="overflow-x-auto">
					<table class=(tableClass)>
						<thead class="bg-stone-50/60">
							<tr>
								<th class=(thClass)>Order</th>
								<th class=(thClass)>Customer</th>
								<th class=(thClass.Add("hidden @xl:table-cell"))>Date</th>
								<th class=(thClass.Add("hidden @xl:table-cell"))>Status</th>
								<th class=(thClass.Add("text-right"))>Total</th>
							</tr>
						</thead>
						<tbody>
							~(for _, o := range recent {
								~(orderRow(o, false))
							})
						</tbody>
					</table>
				</div>,
			}
		</div>
		~>neui.Space{Name: "low_stock", Desc: "Products with few or no units left, linking to each product"} ~card{
			Title: "Low stock",
			Desc: "Reorder before these run out",
			Flush: true,
			Body: <>
				~(if len(st.LowStock) == 0 {
					<p class="px-5 py-6 text-sm text-stone-500">Everything is well stocked.</p>
				} else {
					<ul class="divide-y divide-stone-100">
						~(for _, p := range st.LowStock {
							<li>
								~>neui.Use{Desc: "open product " + p.Name} <a
									(doors.ALink{Model: ProductPath{ID: p.ID}, Batch: true, After: scrollTop})
									class="flex items-center justify-between gap-3 px-5 py-3 transition-colors hover:bg-amber-50/40">
									<div class="min-w-0">
										<p class="truncate text-sm font-medium text-stone-900">~(p.Name)</p>
										<p class="text-xs text-stone-500">~(p.SKU)</p>
									</div>
									~(stockBadge(p.Stock))
								</a>
							</li>
						})
					</ul>
				})
			</>,
		}
	</div>
}

elem kpi(label string, value string, note string, d string, model any, desc string) {
	~~
	body := <>
		<div class="flex items-center justify-between">
			<p class="text-xs font-medium text-stone-500 @xl:text-sm">~(label)</p>
			<span class="flex size-8 items-center justify-center rounded-lg bg-amber-50 text-amber-700">~(icon(d, "size-5"))</span>
		</div>
		<p class="mt-3 text-2xl font-semibold tracking-tight text-stone-900 tabular-nums @xl:text-3xl">~(value)</p>
		<p class="mt-1 text-xs text-stone-500 @xl:text-sm">~(note)</p>
	</>
	~~
	~(if model == nil {
		<div class="rounded-xl bg-white p-4 shadow-xs ring-1 ring-stone-200 @xl:p-5">~(body)</div>
	} else {
		~>neui.Use{Desc: desc} <a
			(doors.ALink{Model: model, Batch: true, After: scrollTop})
			class="block rounded-xl bg-white p-4 shadow-xs ring-1 ring-stone-200 transition hover:ring-amber-300 @xl:p-5">
			~(body)
		</a>
	})
}
