package main

import (
	"context"

	"github.com/doors-dev/doors"
	"github.com/doors-dev/gox"
	"neui.dev"
)

elem workbenchPanel() {
	~~
	if neui.Tier(ctx) != neui.TierDeveloper {
		return nil
	}
	~~
	~neui.Island{
		Name: "workbench",
		Desc: "Apps over the shop's data, in a panel over the page. Build one here when the user wants something the pages don't offer: a chart, visualization, report or dashboard, reviewing and changing many records, comparisons or calculators. Its scripts read orders, customers and products, and by id can create orders, customers and products, change an order's items and quantities, status, shipping address and due date, send payment reminders, refund or cancel orders, and update customers, products and stock. The panel shows only while an app runs; the user can hide it and bring it back.",
		Placeholder: <></>,
		Template: func(slot gox.Comp) gox.Elem {
			return workbenchFrame(slot)
		},
		Library: workbenchLibrary,
	}
}

elem apiSpace() {
	~~
	if neui.Tier(ctx) != neui.TierAgent {
		return nil
	}
	~~
	~>neui.Space{Name: "api", Desc: "The shop's data and operations as tools"} <>
		~(apiEntity("orders", "Orders", readOrders, orderOperations))
		~(apiEntity("customers", "Customers", readCustomers, customerOperations))
		~(apiEntity("products", "Products", readProducts, productOperations))
	</>
}

elem apiEntity(name string, desc string, read neui.Tooler, operations []neui.Tooler) {
	~>neui.Space{Name: name, Desc: desc} <div>
		~(read)
		~(for _, t := range operations {
			~(t)
		})
	</div>
}

elem workbenchFrame(slot gox.Comp) {
	~~
	shown := doors.NewSource(true)
	panel := new(doors.Setter)
	pill := new(doors.Setter)
	open, _ := shown.ReadAndSub(ctx, func(ctx context.Context, v bool) bool {
		doors.Call(ctx, panel.Set("data-open", v))
		doors.Call(ctx, pill.Set("data-open", v))
		return false
	})
	show := func(v bool) doors.AClick {
		return doors.AClick{
			On: func(ctx context.Context, _ doors.RequestPointer) bool {
				shown.Update(ctx, v)
				return false
			},
		}
	}
	~~
	<section
		(panel)
		data-open=(open)
		id="workbench"
		aria-labelledby="workbench-title"
		class="fixed inset-x-4 top-16 z-40 hidden max-h-[calc(100dvh-5rem)] flex-col overflow-hidden rounded-2xl bg-white shadow-2xl ring-1 ring-stone-200 data-open:flex side:top-6 side:left-72 side:max-h-[calc(100dvh-3rem)] docked:right-[29rem]">
		<header class="flex items-start justify-between gap-4 border-b border-stone-100 px-5 py-4">
			<div>
				<h2 id="workbench-title" class="flex items-center gap-2 text-base font-semibold text-stone-900">
					~(icon(iconSparkles, "size-5 text-amber-600"))
					Workbench
				</h2>
				<p class="mt-0.5 text-sm text-stone-500">An app the assistant built for you, on live shop data.</p>
			</div>
			<div class="-mr-2 flex items-center gap-1">
				~>neui.Use{Desc: "hide the Workbench panel so the page is visible; the app keeps running"} <button
					(show(false))
					type="button"
					aria-label="Hide the Workbench"
					class=(btnGhost.Add("px-2"))>
					~(icon(iconMinus, "size-5"))
				</button>
				~>neui.Use{Desc: "close the app in the Workbench"} <button
					(doors.AClick{
						On: func(ctx context.Context, _ doors.RequestPointer) bool {
							neui.IslandEnd(ctx)
							return false
						},
					})
					type="button"
					aria-label="Close the app"
					class=(btnGhost.Add("px-2"))>
					~(icon(iconClose, "size-5"))
				</button>
			</div>
		</header>
		<div class="overflow-y-auto px-5 py-5">~(slot)</div>
	</section>
	<div
		(pill)
		data-open=(open)
		class="pointer-events-none fixed inset-x-4 top-16 z-40 flex justify-center data-open:hidden side:top-6 side:left-72 docked:right-[29rem]">
		~>neui.Use{Desc: "show the hidden Workbench panel with the running app"} <button
			(show(true))
			type="button"
			class="pointer-events-auto inline-flex cursor-pointer items-center gap-2 rounded-full bg-white px-4 py-2 text-sm font-medium text-stone-800 shadow-lg ring-1 ring-stone-200 transition-colors hover:bg-amber-50 hover:text-stone-900 hover:ring-amber-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-500 active:bg-amber-100">
			~(icon(iconSparkles, "size-4 text-amber-600"))
			Show Workbench
		</button>
	</div>
}
