package main

import (
	"context"
	"fmt"

	"github.com/doors-dev/doors"
	"github.com/doors-dev/gox"
	"neui.dev"
)

type customersToolInput struct {
	Search string `json:"search,omitempty" description:"part of a name, email, company or phone; empty for all"`
	Sort string `json:"sort,omitempty" description:"name, orders or spent; prefix - for descending; empty for by name"`
	Page int `json:"page,omitempty" description:"page of the table, 1-based; 0 for the first"`
}

type customersToolOutput struct {
	Shown []customerRow `json:"shown" description:"customers now on the user's screen"`
	Page pageInfo `json:"page"`
}

func (p CustomersPath) withSort(sort string) any {
	p.Sort, p.Page = sort, 0
	return p
}

func (p CustomersPath) withPage(page int) any {
	p.Page = page
	if page == 1 {
		p.Page = 0
	}
	return p
}

elem customersPage(path doors.Source[CustomersPath]) {
	~~
	search := doors.DeriveBeam(path, func(p CustomersPath) string {
		return p.Search
	})
	~~
	~>neui.Space{
		Name: "customers",
		Desc: "Customers list: a search box, a sortable table of customers and its pages; the search lives in the address",
	} <div>
		~pageHeader{
			Title: "Customers",
			Meta: <span>People and companies who buy from the shop.</span>,
			Actions: <>
				~>neui.Use{Desc: "open the form to add a new customer"} <a
					(doors.ALink{Model: CustomersPath{View: ListNew}, Batch: true, After: scrollTop})
					class=(btnPrimary)>
					~(icon(iconPlus, "size-4"))
					New customer
				</a>
			</>,
		}
		<section class="overflow-hidden rounded-xl bg-white shadow-xs ring-1 ring-stone-200">
			~>neui.Space{Name: "search", Desc: "Search box of the customers table"} <div>
				~neui.Tool[customersToolInput, customersToolOutput]{
					Name: "search_customers",
					Desc: "Set the search, sort and page of the customers table the user sees; an empty field clears it",
					Handler: func(ctx context.Context, in customersToolInput) (customersToolOutput, error) {
						next := CustomersPath{Search: in.Search, Sort: in.Sort, Page: in.Page}
						if err := checkSort(next.Sort, "name", "orders", "spent"); err != nil {
							return customersToolOutput{}, err
						}
						shown, info := paginate(shop.Customers(next.Search, next.Sort), next.Page, pageSize)
						next.Page = info.Page
						if next.Page == 1 {
							next.Page = 0
						}
						path.Update(ctx, next)
						return customersToolOutput{Shown: shown, Page: info}, nil
					},
				}
				~(search.Bind(func(q string) gox.Elem {
					return <>
						~neui.Data{Text: "customers matching the search", Object: len(shop.Customers(q, ""))}
					</>
				}))
				~(search.Bind(func(q string) gox.Elem {
					return searchBar("customers-search", "Search by name, email, company or phone", q, "search customers by name, email, company or phone; applies on Enter or when the field loses focus", func(ctx context.Context, v string) {
						path.Mutate(ctx, func(p CustomersPath) CustomersPath {
							p.Search, p.Page = v, 0
							return p
						})
					})
				}))
			</div>
			~>(new(doors.Door)) ~({
				_, _ = shop.version.Effect(ctx)
				p, ok := path.Effect(ctx)
				if !ok {
					return nil
				}
				return customersTable(p)
			})
		</section>
	</div>
}

elem searchBar(id string, placeholder string, value string, desc string, change func(ctx context.Context, v string)) {
	<div class="border-b border-stone-100 bg-stone-50/50 px-5 py-4">
		<div class="relative max-w-md">
			<label for=(id) class="sr-only">~(placeholder)</label>
			<span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-stone-400">
				~(icon(iconSearch, "size-4"))
			</span>
			~>neui.Use{Desc: desc} <input
				(doors.AChange{
					Race: doors.RaceLatest,
					On: func(ctx context.Context, r doors.RequestChange) bool {
						change(ctx, r.Event().Value)
						return false
					},
				})
				id=(id)
				type="search"
				placeholder=(placeholder)
				value=(value)
				class=(inputBase.Add("pl-9"))>
		</div>
	</div>
}

elem customersTable(p CustomersPath) {
	~~
	all := shop.Customers(p.Search, p.Sort)
	rows, info := paginate(all, p.Page, pageSize)
	sort := p.Sort
	if sort == "" {
		sort = "name"
	}
	~~
	~>neui.Space{Name: "table", Desc: "Customers matching the search, one page at a time; the column headers sort it"} <div>
		~neui.Data{Text: "customers shown in the table, with their order count and paid total", Object: rows}
		~neui.Data{Text: fmt.Sprintf("page %d of %d", info.Page, info.Pages)}
		~(if len(all) == 0 {
			~emptyState{
				Icon: iconCustomers,
				Title: "No customers found",
				Body: "Nobody matches this search. Check the spelling or add them as a new customer.",
				Action: <>
					~>neui.Use{Desc: "clear the search"} <a (doors.ALink{Model: CustomersPath{}, Batch: true}) class=(btnSecondary)>Clear search</a>
				</>,
			}
		} else {
			<div class="overflow-x-auto">
				<table class=(tableClass)>
					<thead>
						<tr>
							~sortHeader{Label: "Name", Key: "name", First: "name", Current: sort, Model: p.withSort}
							<th class=(thClass.Add("hidden @2xl:table-cell"))>Company</th>
							<th class=(thClass.Add("hidden @4xl:table-cell"))>Phone</th>
							~sortHeader{Label: "Orders", Key: "orders", First: "-orders", Current: sort, Right: true, Class: "hidden @xl:table-cell", Model: p.withSort}
							~sortHeader{Label: "Spent", Key: "spent", First: "-spent", Current: sort, Right: true, Model: p.withSort}
						</tr>
					</thead>
					<tbody>
						~(for _, c := range rows {
							<tr class=(rowClass)>
								<td class=(tdClass)>
									~>neui.Use{Desc: "open customer " + c.Name} <a (doors.ALink{Model: CustomerPath{ID: c.ID}, Batch: true, After: scrollTop}) class="group flex items-center gap-3">
										~(avatar(c.Name))
										<span class="min-w-0">
											<span class="block font-medium text-stone-900 group-hover:underline">~(c.Name)</span>
											<span class="block text-xs text-stone-500">~(c.Email)</span>
										</span>
									</a>
								</td>
								<td class=(tdClass.Add("hidden text-stone-600 @2xl:table-cell"))>~(dash(c.Company))</td>
								<td class=(tdClass.Add("hidden text-stone-600 tabular-nums @4xl:table-cell"))>~(dash(c.Phone))</td>
								<td class=(tdClass.Add("hidden text-right tabular-nums @xl:table-cell"))>~(c.Orders)</td>
								<td class=(tdClass.Add("text-right font-medium tabular-nums"))>~(money(c.Spent))</td>
							</tr>
						})
					</tbody>
				</table>
			</div>
			~pager{Info: info, Noun: "customers", Model: p.withPage}
		})
	</div>
}

elem avatar(name string) {
	<span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-amber-100 text-xs font-semibold text-amber-800">
		~(initials(name))
	</span>
}

func dash(s string) string {
	if s == "" {
		return "—"
	}
	return s
}
